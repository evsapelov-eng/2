# Только для локального запуска. В GitHub эти значения задаются в
# Settings → Secrets and variables → Actions. Не коммитьте файл .env.

# Секреты
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
OWNER_TELEGRAM_ID=
CHANNEL_ID=
DISCUSSION_GROUP_ID=
STATE_ENCRYPTION_KEY=

# Несекретные параметры (переопределяют config/settings.yaml)
TIMEZONE=Europe/Moscow
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
NOTIFICATION_THRESHOLD=70
MAX_RECOMMENDATIONS_PER_RUN=5
NOTIFICATION_MODE=smart
WEEKLY_REPORT_ENABLED=true
MAX_AI_REQUESTS_PER_RUN=10
MAX_AI_REQUESTS_PER_DAY=18
DATA_RETENTION_DAYS=90

# Локально состояние хранится в файле, а не в ветке bot-state
STATE_BACKEND=local
STATE_LOCAL_PATH=.state/state.enc
