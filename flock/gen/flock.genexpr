c_p = nh_c_p;
c_d = nh_c_d;
c_a1 = nh_c_a1;
c_a2 = nh_c_a2;
c_a3 = nh_c_a3;
tg_target = nh_tg_target;
tg_lpc = nh_tg_lpc;
tg_audio = nh_tg_audio;
tg_accept = nh_tg_accept;
tg_count = nh_tg_count;
tg_resetint = nh_tg_resetint;
tg_quant = nh_tg_quant;
tg_div = nh_tg_div;
l2v = nh_l2v;
c_rc = nh_c_rc;
crst = nh_crst;
gdw = nh_gdw;
guw = nh_guw;
pt = nh_pt;
pf = nh_pf;
preg = nh_preg;
pfz = nh_pfz;
s_sca = nh_s_sca;
