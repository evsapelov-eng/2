Param sq10(0.75, min=-1, max=1);
Param sq11(-1, min=-1, max=1);
Param sq12(0.625, min=-1, max=1);
Param sq13(-1, min=-1, max=1);
Param sq14(-1, min=-1, max=1);
Param sq15(-1, min=-1, max=1);

// recording buffer: the longest quality (Scorched cassette, 384000 frames) + interpolation tail
Data buf(384004, 2);
Data gr(32, 16);
Data prio(32, 1);
Data ftail(256, 2);
Data rv(32768, 1);
Data sum(8, 1);
Data ck(4100, 1);    // codec converter kernel, 256 points per sample of the slower rate
Data hin(512, 2);    // host input ring (codec down-converter)
Data eo(64, 2);      // codec-rate output ring (codec up-converter)
Data srcf(48, 2);    // Sunny tape SRC_FIR<ratio 2, 48 taps>: channel 0 down, 1 up (full, mirrored)
Data gdn(64, 2);     // Sunny tape: codec-rate input history (down-converter)
Data gup(32, 2);     // Sunny tape: core-rate output history (up-converter)
Data wfl(128, 2);    // wow & flutter delay lines (stmlib DelayLine<float, 128>)
Data acs(8, 1);      // converter accumulators: 0 L, 1 R, 2 weight
Data cx(16, 1);      // values passed out of the codec / core stages (see the end of the codec stage)
Data sdl(1024, 1);   // SEED input delay line (beads.cc event_delay: 10 blocks = 2.5 ms)   // per-sample accumulators: 0 L, 1 R, 2 playing grains, 3 active count, 4 best, 5 best remaining

