// ---------------------------------------------------------------- per sample
FSH = samplerate;
k = 0;
j = 0;
// ================================================================ host stage
qi = clamp(floor(quality + 0.5), 0, 3);
// the manual: the quality cannot change while the buffer is frozen (it would be cleared) — held until unfrozen
qi = (hinit > 0.5 && (freeze > 0.5 || was_frozen > 0.5)) ? qc : qi;
qchg = hinit > 0.5 && qi != qc;
// codec rate (Processor::sample_rate with ENABLE_HARDWARE_24K): Cold digital 32 kHz, Scorched cassette
// 24 kHz; Pristine and Sunny tape: the host rate (like the rest of FLØCK)
RC = min(qi > 0.5 && qi < 1.5 ? 32000 : qi > 2.5 ? 24000 : FSH, FSH);
rsm = RC < FSH;
rr = RC / FSH;
if (hinit < 0.5) {
	// sample_rate_conversion_filters.h SRC_FIR<SRC_DOWN, 2, 48> / <SRC_UP, 2, 48> (24 + mirror)
	poke(srcf, -0.0002143728787, 0, 0); poke(srcf, -0.0004113243578, 1, 0); poke(srcf, 0.0003550026182, 2, 0); poke(srcf, 0.001123588805, 3, 0);
	poke(srcf, 0.0002013790146, 4, 0); poke(srcf, -0.002135889966, 5, 0); poke(srcf, -0.001946536068, 6, 0); poke(srcf, 0.002421957824, 7, 0);
	poke(srcf, 0.005099674271, 8, 0); poke(srcf, -0.0004847193956, 9, 0); poke(srcf, -0.008638296788, 10, 0); poke(srcf, -0.005137744633, 11, 0);
	poke(srcf, 0.01000597441, 12, 0); poke(srcf, 0.01464501735, 13, 0); poke(srcf, -0.005419339385, 14, 0); poke(srcf, -0.02582247866, 15, 0);
	poke(srcf, -0.009106955536, 16, 0); poke(srcf, 0.03335521514, 17, 0); poke(srcf, 0.03702172341, 18, 0); poke(srcf, -0.02802414194, 19, 0);
	poke(srcf, -0.08416883646, 20, 0); poke(srcf, -0.01192656678, 21, 0); poke(srcf, 0.1955030744, 22, 0); poke(srcf, 0.3837045956, 23, 0);
	poke(srcf, -0.0004287457573, 0, 1); poke(srcf, -0.0008226487157, 1, 1); poke(srcf, 0.0007100052364, 2, 1); poke(srcf, 0.00224717761, 3, 1);
	poke(srcf, 0.0004027580292, 4, 1); poke(srcf, -0.004271779932, 5, 1); poke(srcf, -0.003893072135, 6, 1); poke(srcf, 0.004843915649, 7, 1);
	poke(srcf, 0.01019934854, 8, 1); poke(srcf, -0.0009694387912, 9, 1); poke(srcf, -0.01727659358, 10, 1); poke(srcf, -0.01027548927, 11, 1);
	poke(srcf, 0.02001194882, 12, 1); poke(srcf, 0.02929003471, 13, 1); poke(srcf, -0.01083867877, 14, 1); poke(srcf, -0.05164495731, 15, 1);
	poke(srcf, -0.01821391107, 16, 1); poke(srcf, 0.06671043028, 17, 1); poke(srcf, 0.07404344683, 18, 1); poke(srcf, -0.05604828388, 19, 1);
	poke(srcf, -0.1683376729, 20, 1); poke(srcf, -0.02385313356, 21, 1); poke(srcf, 0.3910061488, 22, 1); poke(srcf, 0.7674091912, 23, 1);
	poke(srcf, peek(srcf, 0, 0), 47, 0); poke(srcf, peek(srcf, 0, 1), 47, 1);
	poke(srcf, peek(srcf, 1, 0), 46, 0); poke(srcf, peek(srcf, 1, 1), 46, 1);
	poke(srcf, peek(srcf, 2, 0), 45, 0); poke(srcf, peek(srcf, 2, 1), 45, 1);
	poke(srcf, peek(srcf, 3, 0), 44, 0); poke(srcf, peek(srcf, 3, 1), 44, 1);
	poke(srcf, peek(srcf, 4, 0), 43, 0); poke(srcf, peek(srcf, 4, 1), 43, 1);
	poke(srcf, peek(srcf, 5, 0), 42, 0); poke(srcf, peek(srcf, 5, 1), 42, 1);
	poke(srcf, peek(srcf, 6, 0), 41, 0); poke(srcf, peek(srcf, 6, 1), 41, 1);
	poke(srcf, peek(srcf, 7, 0), 40, 0); poke(srcf, peek(srcf, 7, 1), 40, 1);
	poke(srcf, peek(srcf, 8, 0), 39, 0); poke(srcf, peek(srcf, 8, 1), 39, 1);
	poke(srcf, peek(srcf, 9, 0), 38, 0); poke(srcf, peek(srcf, 9, 1), 38, 1);
	poke(srcf, peek(srcf, 10, 0), 37, 0); poke(srcf, peek(srcf, 10, 1), 37, 1);
	poke(srcf, peek(srcf, 11, 0), 36, 0); poke(srcf, peek(srcf, 11, 1), 36, 1);
	poke(srcf, peek(srcf, 12, 0), 35, 0); poke(srcf, peek(srcf, 12, 1), 35, 1);
	poke(srcf, peek(srcf, 13, 0), 34, 0); poke(srcf, peek(srcf, 13, 1), 34, 1);
	poke(srcf, peek(srcf, 14, 0), 33, 0); poke(srcf, peek(srcf, 14, 1), 33, 1);
	poke(srcf, peek(srcf, 15, 0), 32, 0); poke(srcf, peek(srcf, 15, 1), 32, 1);
	poke(srcf, peek(srcf, 16, 0), 31, 0); poke(srcf, peek(srcf, 16, 1), 31, 1);
	poke(srcf, peek(srcf, 17, 0), 30, 0); poke(srcf, peek(srcf, 17, 1), 30, 1);
	poke(srcf, peek(srcf, 18, 0), 29, 0); poke(srcf, peek(srcf, 18, 1), 29, 1);
	poke(srcf, peek(srcf, 19, 0), 28, 0); poke(srcf, peek(srcf, 19, 1), 28, 1);
	poke(srcf, peek(srcf, 20, 0), 27, 0); poke(srcf, peek(srcf, 20, 1), 27, 1);
	poke(srcf, peek(srcf, 21, 0), 26, 0); poke(srcf, peek(srcf, 21, 1), 26, 1);
	poke(srcf, peek(srcf, 22, 0), 25, 0); poke(srcf, peek(srcf, 22, 1), 25, 1);
	poke(srcf, peek(srcf, 23, 0), 24, 0); poke(srcf, peek(srcf, 23, 1), 24, 1);
}
// Max does not run big loops (a 4097-step loop on the first sample made the device silent):
// the converter kernel table is filled progressively, 8 entries per host sample (513 samples);
// the codec qualities stay silent until it is complete
if (ckn < 4096.5) {
	poke(ck, csinc(ckn / 256), ckn, 0);
	poke(ck, csinc((ckn + 1) / 256), ckn + 1, 0);
	poke(ck, csinc((ckn + 2) / 256), ckn + 2, 0);
	poke(ck, csinc((ckn + 3) / 256), ckn + 3, 0);
	poke(ck, csinc((ckn + 4) / 256), ckn + 4, 0);
	poke(ck, csinc((ckn + 5) / 256), ckn + 5, 0);
	poke(ck, csinc((ckn + 6) / 256), ckn + 6, 0);
	poke(ck, csinc((ckn + 7) / 256), ckn + 7, 0);
}
nckn = min(ckn + 8, 4097);
ckok = nckn > 4096.5;
poke(hin, in1, hw, 0);
poke(hin, in2, hw, 1);
// codec clock: integer accumulator (RC per host sample), a ctk when it passes the host rate
nacc = (qchg || !rsm) ? 0 : cacc + RC;
ctk = qchg || !rsm || nacc >= FSH;
nacc = nacc >= FSH ? nacc - FSH : nacc;
dlt = nacc / RC;   // time since this codec sample, in codec samples
ein1 = rsm ? 0 : in1;
ein2 = rsm ? 0 : in2;
if (rsm && ctk && ckok) {
	// down-converter: kernel centred 16 codec samples back (latency), weights normalised
	poke(acs, 0, 0, 0);
	poke(acs, 0, 1, 0);
	poke(acs, 0, 2, 0);
	nj = floor(33 / rr);
	for (k = 0; k < nj; k += 1) {
		ka = abs(rr * k - dlt - 16) * 256;
		ki = floor(ka);
		if (ki < 4096) {
			wk = peek(ck, ki, 0) + (peek(ck, ki + 1, 0) - peek(ck, ki, 0)) * (ka - ki);
			hix = wrapi(hw - k, 512);
			poke(acs, peek(acs, 0, 0) + peek(hin, hix, 0) * wk, 0, 0);
			poke(acs, peek(acs, 1, 0) + peek(hin, hix, 1) * wk, 1, 0);
			poke(acs, peek(acs, 2, 0) + wk, 2, 0);
		}
	}
	ein1 = peek(acs, 0, 0) / peek(acs, 2, 0);
	ein2 = peek(acs, 1, 0) / peek(acs, 2, 0);
}
nhw = wrapi(hw + 1, 512);

// ================================================================ codec stage (one codec sample)
// every History written by the codec / core stages goes through nh_* and is written back
// unconditionally at the very end (like v0.2, which compiled in Max)
nh_wp = wp;
// display copy of the recording (native device: buffer~ + waveform~): value and index of the frame written now
tapev = 0;
tapei = -1;
nh_nwr = nwr;
nh_sdn = sdn;
nh_interval = interval;
nh_lastpos = lastpos;
nh_lastspd = lastspd;
nh_prev_l = prev_l;
nh_prev_r = prev_r;
nh_hp1 = hp1;
nh_hp2 = hp2;
nh_hq1 = hq1;
nh_hq2 = hq2;
nh_lim_in_p = lim_in_p;
nh_lim_in_lp = lim_in_lp;
nh_was_frozen = was_frozen;
nh_tail_wp = tail_wp;
nh_tail_xf = tail_xf;
nh_s_fb = s_fb;
nh_i_fb = i_fb;
nh_init = init;
nh_s_time = s_time;
nh_s_size = s_size;
nh_s_shape = s_shape;
nh_s_pitch = s_pitch;
nh_s_tamt = s_tamt;
nh_s_samt = s_samt;
nh_s_hamt = s_hamt;
nh_s_pamt = s_pamt;
nh_s_dens = s_dens;
nh_s_timeh = s_timeh;
nh_s_fbk = s_fbk;
nh_s_dwk = s_dwk;
nh_s_rvk = s_rvk;
nh_s_dry = s_dry;
nh_s_wet = s_wet;
nh_tg_phase = tg_phase;
nh_tg_ratio = tg_ratio;
nh_tg_freq = tg_freq;
nh_tg_elapsed = tg_elapsed;
nh_prev_gate = prev_gate;
nh_prev_ext = prev_ext;
nh_g_peak = g_peak;
nh_g_agc = g_agc;
nh_g_stable = g_stable;
nh_g_gain = g_gain;
nh_g_inc = g_inc;
nh_g_time = g_time;
nh_g_rst = g_rst;
nh_sdw = sdw;
nh_lim_pre_p = lim_pre_p;
nh_lim_pre_lp = lim_pre_lp;
nh_lim_out_p = lim_out_p;
nh_lim_out_lp = lim_out_lp;
nh_rv_wp = rv_wp;
nh_rv_lp1 = rv_lp1;
nh_rv_lp2 = rv_lp2;
nh_rv_dry = rv_dry;
nh_rv_wet = rv_wet;
nh_rv_send = rv_send;
nh_blk = blk;
nh_i_dry = i_dry;
nh_i_wet = i_wet;
nh_i_rd = i_rd;
nh_i_rw = i_rw;
nh_i_rs = i_rs;
nh_l1y0 = l1y0;
nh_l1y1 = l1y1;
nh_l2y0 = l2y0;
nh_l2y1 = l2y1;
nh_l1v = l1v;
nh_prev_bp = prev_bp;
nh_bar_cnt = bar_cnt;
nh_was_run = was_run;
nh_l1_ph = l1_ph;
nh_l2_ph = l2_ph;
nh_rn_ph = rn_ph;
nh_rn_pph = rn_pph;
nh_rn_seed = rn_seed;
nh_rn_from = rn_from;
nh_rn_to = rn_to;
nh_env_st = env_st;
nh_ck_ph = ck_ph;
nh_c_t = c_t;
nh_c_s = c_s;
nh_c_h = c_h;
nh_c_p = c_p;
nh_c_d = c_d;
nh_c_a1 = c_a1;
nh_c_a2 = c_a2;
nh_c_a3 = c_a3;
nh_tg_target = tg_target;
nh_tg_lpc = tg_lpc;
nh_tg_audio = tg_audio;
nh_tg_accept = tg_accept;
nh_tg_count = tg_count;
nh_tg_resetint = tg_resetint;
nh_tg_quant = tg_quant;
nh_tg_div = tg_div;
nh_l2v = l2v;
nh_c_rc = c_rc;
nh_crst = crst;
nh_gdw = gdw;
nh_guw = guw;
nh_pt = pt;
nh_pf = pf;
nh_preg = preg;
nh_pfz = pfz;
nh_s_sca = s_sca;
nh_i_sca = i_sca;
nh_wf_rph = wf_rph;
nh_wf_rf = wf_rf;
nh_wf_wph = wf_wph;
nh_wf_fph = wf_fph;
nh_wf_del = wf_del;
nh_wf_inc = wf_inc;
nh_wf_lpl = wf_lpl;
nh_wf_lpr = wf_lpr;
nh_wf_w = wf_w;
nh_wf_pend = wf_pend;
if (ctk) {
FS = RC;
MAXD = qi < 0.5 ? 192000 : qi > 2.5 ? 384000 : 256000;
// Processor::Configure on a quality change: buffer cleared, grains / trigger generator / limiters /
// reverb LFOs re-initialised, codec blocks restart (FLØCK also restarts the core's filters)
fresh = init < 0.5 || qchg;
rat = qi > 1.5 && qi < 2.5 ? 2 : 1;
RG = FS / rat;
if (fresh) {
	for (k = 0; k < 32; k += 1) {
		poke(prio, k, k, 0);
		poke(gr, 3, k, 0);
		poke(gr, 1, k, 6);
		poke(gr, 0, k, 7);
		poke(gr, 0, k, 14);
	}
}
// Configure (quality change): the module clears the buffer. FLØCK does not loop over it (Max does
// not run big loops); the frames written since the change are counted (nwr) and everything older
// reads as 0 — the same result. The SEED delay line likewise (sdn).
// ---- controls (pot laws + smoothing like the module's ADC low-pass; no glide on load)
// Like the module: pots are read once per block of sr/4000 samples (cv_reader.Read in the audio
// callback): law → one-pole 0.05 → hysteresis (TIME 0.001). On load: no glide from zero.
blkc = qchg ? 0 : blk;
newblk = blkc < 0.5;
// the module's audio block: kBlockRate = 4000 → sr / 4000 samples (12 at 48 kHz)
BLK = floor(FS / 4000 + 0.5);
// Sunny tape: the block must hold whole pairs for the ratio-2 converters (even; 12 at 44.1 / 48 kHz)
BLK = rat > 1.5 ? 2 * floor(FS / 8000 + 0.5) : BLK;
nblk = blkc > BLK - 1.5 ? 0 : blkc + 1;
kp = init < 0.5 ? 1 : newblk ? 0.05 : 0;
st_time = s_time + (time - s_time) * kp;
th_err = st_time - s_timeh;
st_timeh = init < 0.5 ? st_time : th_err > 0.001 ? st_time - 0.001 : th_err < -0.001 ? st_time + 0.001 : s_timeh;
st_fbk = s_fbk + (feedback - s_fbk) * kp;
st_dwk = s_dwk + (drywet - s_dwk) * kp;
st_rvk = s_rvk + (reverb - s_rvk) * kp;
st_size = s_size + (size - s_size) * kp;
st_shape = s_shape + (shape - s_shape) * kp;
st_pitch = s_pitch + (detune_law(pitch) - s_pitch) * kp;
st_tamt = s_tamt + (attenu_law(time_amt) - s_tamt) * kp;
st_samt = s_samt + (attenu_law(size_amt) - s_samt) * kp;
st_hamt = s_hamt + (attenu_law(shape_amt) - s_hamt) * kp;
st_pamt = s_pamt + (attenu_law(pitch_amt) - s_pamt) * kp;
st_dens = s_dens + (density - s_dens) * kp;
seedstate = seedlatch > 0.5 ? 2 : seed > 0.5 ? 1 : 0;

// ---- tempo from Live: bar phase (phasor~ 1n @lock 1) on in7; bars counted modulo 24
bp = in7;
running = abs(bp - prev_bp) > 0;
nbars = bp < prev_bp - 0.5 ? (bar_cnt > 22.5 ? 0 : bar_cnt + 1) : bar_cnt;
started = running && was_run < 0.5;
// synced sources run 10 blocks ahead: the SEED input delay of the module (2.5 ms, kept for the
// CV-settling it gives) then lands their gates exactly on Live's grid
dph = running ? bp - prev_bp + (bp < prev_bp - 0.5 ? 1 : 0) : 0;
pos = nbars + bp + dph * floor(FS / 4000 + 0.5) * 10 + 0.000000001;   // + 1e-9 bar: exact grid points round up, not down
// ---- input gain (GainControl::Process): block rate for the learning, sample rate for the peak
g_ign = trunc(FS * 1);
g_act = trunc(FS * 6);
gtime = init < 0.5 ? 0 : (agc_restart != g_rst ? g_ign : g_time);
// GainControl::Init(new rate, reset = false) on a quality change: a finished learning stays finished
gtime = qchg ? (g_time >= trunc(c_rc * 6) ? g_act : 0) : gtime;
gagc = g_agc;
gstb = g_stable;
ginc = g_inc;
isca = i_sca;
if (newblk) {
	ghz = BLK / FS;
	gerr = g_peak - gagc;
	if (gtime < g_ign) {
		gagc = 0.5;
	} else if (gtime < g_act) {
		gagc = gagc + (gerr > 0 ? 10 * ghz : 2 * ghz) * gerr;
		gstb = gagc;
	} else {
		gagc = gagc + (gerr > 0 ? 5 * ghz : (g_peak > gstb ? 0.5 : 0.01) * ghz) * gerr;
	}
	gtime = (gtime > g_ign || g_peak > 0.001) ? min(gtime + BLK, g_act) : gtime;
	gopt = min(0.9 / min(gagc, 0.9), 40);
	gtarget = agc > 0.5 ? gopt : ingain;
	ginc = (gtarget - g_gain) / BLK;
	// soft clipping of the manual gain: Scorched cassette ON, Sunny tape DYNAMIC, digital OFF
	isca = ((qi > 2.5 ? 1 : qi > 1.5 ? clamp(2 * (ingain / gopt - 0.75), 0, 1) : 0) - s_sca) / BLK;
}
ggain = g_gain + ginc;
gpk = max(abs(ein1), abs(ein2));
gpe = gpk - g_peak;
npeak = g_peak + (gpe > 0 ? 0.1 : 2 / FS) * gpe;
// (the amount only moves while it is used: ParameterInterpolator::Next is not called otherwise)
sca = (agc < 0.5 && qi > 1.5) ? s_sca + isca : s_sca;
xl = ein1 * ggain;
xr = ein2 * ggain;
cll = clamp(xl, -1, 1);
clr = clamp(xr, -1, 1);
inl = agc > 0.5 ? xl : (qi > 1.5 ? cll + ((1 - 0.05) * sclip(xl + 0.05) - 0.05 - cll) * sca : cll);
inr = agc > 0.5 ? xr : (qi > 1.5 ? clr + ((1 - 0.05) * sclip(xr + 0.05) - 0.05 - clr) * sca : clr);
learning = agc > 0.5 && gtime < g_act;

// ---- sources (MOD tab)
l1d = divper(floor(l1_rate * 14 + 0.5));
l1f = fract(l1_ph + 0.02 * pow(1000, l1_rate) / FS);
l1f = (l1_reset > 0.5 && started) ? 0 : l1f;
s1 = lfo_shape(l1_sync > 0.5 ? fract(pos * l1d) : l1f, l1_shape) * l1_amt;
l2d = divper(floor(l2_rate * 14 + 0.5));
l2f = fract(l2_ph + 0.02 * pow(1000, l2_rate) / FS);
l2f = (l2_reset > 0.5 && started) ? 0 : l2f;
s2 = lfo_shape(l2_sync > 0.5 ? fract(pos * l2d) : l2f, l2_shape) * l2_amt;
// RANDOM: random walk like RandomWalkModulation (own generator, not the grains' random stream)
rnf = rn_sync > 0.5 ? fract(pos * divper(floor(rn_rate * 14 + 0.5))) : fract(rn_ph + 0.02 * pow(1000, rn_rate) / FS);
rnwrap = rnf < rn_pph || init < 0.5;   // also on load: start from a random value, not from 0
nseed = rnwrap ? wrapi(rn_seed * 1664525 + 1013904223, 4294967296) : rn_seed;
nfrom = rnwrap ? rn_to : rn_from;
nto = rnwrap ? nseed / 4294967296 * 2 - 1 : rn_to;
s3 = (rn_smooth > 0.5 ? nfrom + (nto - nfrom) * sstep(rnf) : nto) * rn_amt;
// ENV: follower of the input, gain ×0.25 … ×16
ein = max(abs(inl), abs(inr));
nenv = env_st + (ein - env_st) * (ein > env_st ? 1 - exp(-1 / (0.003 * FS)) : 1 - exp(-1 / (0.15 * FS)));
s4 = clamp(nenv * 0.25 * pow(64, env_gain), 0, 1);
// CLOCK: tempo division (sync) or 0.1 … 40 Hz
ckf = fract(ck_ph + 0.1 * pow(400, ck_rate) / FS);
ckp = ck_sync > 0.5 ? fract(pos * divper(floor(ck_rate * 14 + 0.5))) : ckf;
s5 = (ckp < 0.5 && (ck_sync < 0.5 || running)) ? 1 : 0;
// SEQ: steps at the tempo division, length 1..16; value 0..1, gate in the first half of an "on" step
spos = pos * divper(sq_div);
sstp = wrapi(floor(spos), floor(sq_len));
sval = sstp < 0.5 ? sq0 : sstp < 1.5 ? sq1 : sstp < 2.5 ? sq2 : sstp < 3.5 ? sq3 : sstp < 4.5 ? sq4 : sstp < 5.5 ? sq5 : sstp < 6.5 ? sq6 : sstp < 7.5 ? sq7 : sstp < 8.5 ? sq8 : sstp < 9.5 ? sq9 : sstp < 10.5 ? sq10 : sstp < 11.5 ? sq11 : sstp < 12.5 ? sq12 : sstp < 13.5 ? sq13 : sstp < 14.5 ? sq14 : sq15;
s6 = max(sval, 0);
g6 = (sval >= 0 && fract(spos) < 0.5 && running) ? 1 : 0;
// gates: LFO / RANDOM positive half, ENV above 0.25, CLOCK and SEQ their pulses
g1 = s1 > 0;
g2 = s2 > 0;
g3 = s3 > 0;
g4 = s4 > 0.25;
// ---- destinations, read like the module's CV inputs (once per block, CvReader low-pass)
has_t = time_cv > 0.5 || dst_time > 0.5;
has_s = size_cv > 0.5 || dst_size > 0.5;
has_h = shape_cv > 0.5 || dst_shape > 0.5;
has_p = pitch_cv > 0.5 || dst_pitch > 0.5;
rt_ = dst_time > 0.5 ? pick(dst_time, s1, s2, s3, s4, s5, s6, in3) : in3;
rs_ = dst_size > 0.5 ? pick(dst_size, s1, s2, s3, s4, s5, s6, in4) : in4;
rh_ = dst_shape > 0.5 ? pick(dst_shape, s1, s2, s3, s4, s5, s6, in5) : in5;
rp_ = dst_pitch > 0.5 ? pick(dst_pitch, s1, s2, s3, s4, s5, s6, in6 / 12) * 12 : in6;
rd_ = pick(dst_density, s1, s2, s3, s4, s5, s6, in10) * dn_amt;
ra1 = pick(dst_feedback, s1, s2, s3, s4, s5, s6, in11);
ra2 = pick(dst_drywet, s1, s2, s3, s4, s5, s6, in11);
ra3 = pick(dst_reverb, s1, s2, s3, s4, s5, s6, in11);
// CvChannel low-pass per block: TIME/SIZE/SHAPE 0.5, PITCH/DENSITY 1.0, ASSIGN 0.1 (first sample: direct)
k5 = init < 0.5 ? 1 : newblk ? 0.5 : 0;
k10 = init < 0.5 ? 1 : newblk ? 1 : 0;
k1 = init < 0.5 ? 1 : newblk ? 0.1 : 0;
cv_t = c_t + (rt_ - c_t) * k5;
cv_s = c_s + (rs_ - c_s) * k5;
cv_h = c_h + (rh_ - c_h) * k5;
cv_p = c_p + (rp_ - c_p) * k10;
cv_d = c_d + (rd_ - c_d) * k10;
cv_a1 = c_a1 + (ra1 - c_a1) * k1;
cv_a2 = c_a2 + (ra2 - c_a2) * k1;
cv_a3 = c_a3 + (ra3 - c_a3) * k1;
// FREEZE / SEED gate inputs (per sample, like the module's gate inputs)
frozen = freeze > 0.5 || (dst_freeze > 0.5 && pick(dst_freeze, g1, g2, g3, g4, s5, g6, in9) > 0.5);
ext = dst_seed > 0.5;
egate_now = ext && pick(dst_seed, g1, g2, g3, g4, s5, g6, in8) > 0.5;
// beads.cc: "Delay the seed input by 2.5ms" (event_delay.Read(size * 10)) — lets a CV
// sent together with the gate (e.g. SEQ → TIME and SEQ → SEED) settle first
poke(sdl, egate_now, sdw, 0);
sdn0 = qchg ? 0 : sdn;
egate = ext && sdn0 >= BLK * 10 && peek(sdl, wrapi(sdw - BLK * 10, 1024), 0) > 0.5;
nsdn = min(sdn0 + 1, 2000);
nsdw = wrapi(sdw + 1, 1024);

// ---- trigger generator (Processor::Process + TriggerGenerator::Render)
expo = clamp(20 * (abs(st_dens - 0.5) - 0.225), 0, 1);
lin_fm = (1 - expo) * cv_d;
exp_fm = expo * cv_d;
divmode = ext && seedstate > 1.5;
dens = clamp(st_dens + lin_fm + (divmode ? exp_fm : 0), 0, 1);
fmr = divmode ? 1 : pow(2, exp_fm * 60 / 12);
// gate stream: latched mode with an external SEED = the clock alone (divider), else button OR input
// the SEED input has its own edge memory (beads.cc previous_seed, updated whenever patched);
// the merged gate keeps TriggerGenerator::previous_flags_ (updated outside the divider)
erising = egate && prev_ext < 0.5;
sgate = divmode ? egate : (seedstate > 0.5 || egate);
rising = divmode ? erising : (sgate && (fresh ? 0 : prev_gate) < 0.5);
npg = divmode ? prev_gate : sgate;
ph = fresh ? 0 : tg_phase;
ratio = fresh ? 1 : tg_ratio;
tapf = tg_freq;
tg_el = fresh ? trunc(FS / 2) : tg_elapsed;
trig = 0;
frac = 0;
regularity = 1;
maxf = 130.81278 / FS;
tgt = fresh ? 2 / FS : tg_target;
tapf = fresh ? 2 / FS : tapf;
ndiv = fresh ? 1 : tg_div;
lpc = fresh ? 1 : tg_lpc;
aud = fresh ? 0 : tg_audio;
acc_p = fresh ? 1 : tg_accept;
pcount = fresh ? 0 : tg_count;
rint = fresh ? trunc(FS * 4) : tg_resetint;
quant = fresh ? 0 : tg_quant;
if (divmode) {
	// ---- RenderDivider: clocked SEED (division CCW / probability CW of the incoming pulses)
	qv = dens * 2.15 * 8 - 0.5;
	qs = qv > quant ? -1 : 1;
	quant = dens < 0.48 ? clamp(trunc(qv + qs * 0.075 + 0.5), 0, 7) : quant;
	division = dens < 0.48 ? divratio(quant) : 1;
	psq = dens < 0.48 ? 1.01 : max((dens - 0.52) * 2.15, 0);
	prob = psq * psq;
	tapf = tapf + (tgt - tapf) * lpc;
	ph = ph + tapf;
	if (rising) {
		if (tg_el >= rint) {
			pcount = 0;
			ph = 0;
		}
		rint = max(trunc(FS * 4), 4 * tg_el);
		thr = trunc(FS / 48) + (aud > 0.5 ? 8 : 0);
		aud = (tg_el < thr) && (prob >= 1);
		acc_p = rnd() < prob && wrapi(pcount, division) < 0.5;
		if (acc_p) {
			period = tg_el;
			pfreq = 1 / period;
			tgt = prob >= 1 ? pfreq / division : pfreq * prob;
			if (aud) {
				noglide = division != ndiv;
				ndiv = division;
				noglide = noglide || tgt > (1.02 + 2 * pfreq) * tapf || tgt < (0.98 - 2 * pfreq) * tapf;
				lpc = noglide ? 1 : period / FS;
			} else {
				ph = 0;
				lpc = 1;
			}
		} else if (prob < 1) {
			tgt = tgt * (1 - prob);
		}
		pcount = wrapi(pcount + 1, 48);
		tg_el = 0;
	}
	tg_el = tg_el + 1;
	if (aud) {
		if (ph >= 1) {
			ph = ph - 1;
			frac = ph / tapf;
			trig = 1;
		}
	} else {
		ph = min(ph, 1);
		trig = acc_p && rising;
	}
	regularity = prob >= 1 ? 1 : 0;
} else if (dens < 0.48 || dens > 0.52) {
	randomize = dens > 0.52;
	f = (randomize ? 0.5 * maxf * pow(2, -(1 - dens) * 16) : maxf * pow(2, -dens * 16)) * fmr;
	if (!randomize) {
		ratio = 1;
	}
	ff = clamp(f * ratio, 0.000001, 0.25);
	ph = ph + (sgate ? ff : 0);
	reset = 0;
	if (rising) {
		ph = 0;
		reset = 1;
	} else if (ph >= 1) {
		ph = ph - 1;
		frac = ph / ff;
		reset = 1;
	}
	if (reset && randomize) {
		x = 0.1 + 0.9 * rnd();
		ratio = -1 / (-x * (1 + x * (0.5 + x * (0.3333 + x * 0.25))));
	}
	trig = reset && sgate;
	regularity = randomize ? 0 : 1;
} else if (seedstate < 1.5 || ext) {
	// manual taps: one grain per press
	ph = ph + tapf;
	if (rising) {
		ph = 0;
		tapf = 1 / tg_el;
		tg_el = 0;
	}
	tg_el = tg_el + 1;
	ph = min(ph, 1);
	trig = rising;
	regularity = 1 - (dens - 0.48) * 25;
}

// ---- Sunny tape: GranularProcessor<ratio 2> — the core runs on every second codec sample between
// the module's SampleRateConverter<SRC_DOWN / SRC_UP, 2, 48>. Streaming (FLØCK): a pair is processed
// on its second sample, so the up-converted wet signal comes 2 codec samples later than in the
// module's block processing (42 µs at 48 kHz).
gtick = rat < 1.5 || wrapi(blkc, 2) > 0.5;
cnew = rat < 1.5 ? newblk : blkc < 1.5;
CBLK = BLK / rat;
ncrst = qchg ? 1 : crst;
cfresh = ncrst > 0.5 && gtick;
cin_l = inl;
cin_r = inr;
ctrig = trig;
cfrac = frac;
creg = regularity;
cfrz = frozen;
upl = 0;
upr = 0;
ngdw = gdw;
nguw = guw;
if (rat > 1.5) {
	ngdw = wrapi(gdw + 1, 64);
	poke(gdn, inl, ngdw, 0);
	poke(gdn, inr, ngdw, 1);
	// up-converter output for this codec sample (phase 1 on the pair's second sample), before the push
	poke(acs, 0, 0, 0);
	poke(acs, 0, 1, 0);
	for (k = 0; k < 24; k += 1) {
		hk = peek(srcf, 2 * k + (gtick ? 1 : 0), 1);
		poke(acs, peek(acs, 0, 0) + peek(gup, wrapi(guw - k, 32), 0) * hk, 0, 0);
		poke(acs, peek(acs, 1, 0) + peek(gup, wrapi(guw - k, 32), 1) * hk, 1, 0);
	}
	upl = peek(acs, 0, 0);
	upr = peek(acs, 1, 0);
	if (gtick) {
		poke(acs, 0, 0, 0);
		poke(acs, 0, 1, 0);
		for (k = 0; k < 48; k += 1) {
			hk = peek(srcf, k, 0);
			poke(acs, peek(acs, 0, 0) + peek(gdn, wrapi(ngdw - k, 64), 0) * hk, 0, 0);
			poke(acs, peek(acs, 1, 0) + peek(gdn, wrapi(ngdw - k, 64), 1) * hk, 1, 0);
		}
		cin_l = peek(acs, 0, 0);
		cin_r = peek(acs, 1, 0);
		// DownsampleTriggers / DownsampleGate: first trigger of the pair, fractional (f + j) / 2
		ctrig = pt > 0.5 || trig;
		cfrac = pt > 0.5 ? pf / 2 : (frac + 1) / 2;
		creg = preg;
		cfrz = pfz > 0.5 || frozen;
	}
}
// ================================================================ core stage
if (gtick) {
// ---- feedback into the recording (GranularProcessor::ProcessInternal)
// 16-bit: feedback² · 3 then the brickwall limiter; 12 / 8-bit: feedback · 3 / g, limiter, then
// SoftClip(s · g) crossfaded with the input by the feedback amount (g = 1.3 / 1.75)
slg = qi < 0.5 ? 0 : qi > 2.5 ? 1.75 : 1.3;
s_fb0 = cfresh ? 0 : s_fb;
inc_fb = cnew ? (clamp(st_fbk * 1.005 + (dst_feedback > 0.5 ? cv_a1 * fb_amt : 0), 0, 1) - s_fb0) / CBLK : i_fb;
fbk = s_fb0 + inc_fb;
pvl = cfresh ? 0 : prev_l;
pvr = cfresh ? 0 : prev_r;
sl = slg > 0 ? cin_l + pvl * fbk * (3 / slg) : cin_l + pvl * fbk * fbk * 3;
sr = slg > 0 ? cin_r + pvr * fbk * (3 / slg) : cin_r + pvr * fbk * fbk * 3;
pk = min(max(abs(sl), abs(sr)), 40);
lip0 = cfresh ? 0.5 : lim_in_p;
lilp0 = cfresh ? 0.5 : lim_in_lp;
e1 = pk - lip0;
li_p = lip0 + (e1 > 0 ? 0.1 : 1 / RG) * e1;
e2 = li_p - lilp0;
li_lp = lilp0 + (e2 > 0 ? 0.5 : 1 / RG) * e2;
lg = li_lp <= 0.95 ? 1 : 0.95 / li_lp;
sl = sl * lg;
sr = sr * lg;
if (slg > 0) {
	sl = cin_l + fbk * (sclip(sl * slg) - cin_l);
	sr = cin_r + fbk * (sclip(sr * slg) - cin_r);
}

// ---- recording buffer with freeze tail (DelayLine::Write(in, frozen))
w = cfresh ? 0 : wp;
twp = cfresh ? 0 : tail_wp;
txf = cfresh ? 0 : tail_xf;
wfz = cfresh ? 0 : was_frozen;
nwr0 = cfresh ? 0 : nwr;
nwr1 = nwr0;
if (cfrz) {
	if (wfz < 0.5) {
		twp = 0;
	}
	if (twp < 256) {
		poke(ftail, sl, twp, 0);
		poke(ftail, sr, twp, 1);
		twp = twp + 1;
	}
} else {
	if (wfz > 0.5 && twp > 0) {
		txf = twp;
	}
	if (twp > 0) {
		tpos = txf - twp;
		g = sstep(twp / txf);
		sl = sl + (peek(ftail, tpos, 0) - sl) * g;
		sr = sr + (peek(ftail, tpos, 1) - sr) * g;
		twp = twp - 1;
	}
	ql = qi < 0.5 ? q16(sl) : qi < 2.5 ? q12(sl) : mulaw(sl);
	qr = qi < 0.5 ? q16(sr) : qi < 2.5 ? q12(sr) : mulaw(sr);
	tapev = (ql + qr) * 0.5;
	tapei = w;
	poke(buf, ql, w, 0);
	poke(buf, qr, w, 1);
	if (w < 4) {
		poke(buf, ql, w + MAXD, 0);
		poke(buf, qr, w + MAXD, 1);
	}
	w = w == 0 ? MAXD - 1 : w - 1;
	nwr1 = min(nwr0 + 1, MAXD + 1);
}

// ---- grain start (DelayGranularPlayer::Render + DelayGrain::Start)
gint = interval;
lpos = lastpos;
lspd = lastspd;
if (ctrig) {
	poke(sum, 1, 3, 0);
	for (k = 0; k < 32; k += 1) {
		if (peek(gr, k, 0) < 2.5 && peek(gr, k, 6) > 0) {
			poke(sum, peek(sum, 3, 0) + 1, 3, 0);
		}
	}
	nact = peek(sum, 3, 0);
	tamt = st_tamt;
	samt = st_samt;
	hamt = st_hamt;
	pamt = st_pamt;
	dur_k = rparam(st_size, samt, cv_s, has_s, 1, 1);
	rev = dur_k < 0.3333333;
	amp = 1 / sqrt(nact);
	spread = min(1, ramount(tamt, has_t) + ramount(samt, has_s) + ramount(hamt, has_h) + ramount(pamt, has_p) + 1 - creg);
	u = rnd();
	v = rnd();
	pan = 0.5 + (u - 0.5) * min(0.5 * nact * spread * v, 1);
	maxdel = MAXD - 2 * 257;
	gdelay = rparam(st_timeh, tamt, cv_t, has_t, 1, 1) * maxdel + 257;
	semis = rparam(st_pitch, pamt, cv_p, has_p, 24, 0);
	speed = (rev ? -1 : 1) * pow(2, semis / 12);
	csh = rev ? dur_k * 3 * (2 - dur_k * 3) : 1 - 1.5 * (dur_k - 0.3333333);
	duration = pow(2, min(1, 1.025 * csh) * -9) * RG * 4;
	shp = rparam(st_shape, hamt, cv_h, has_h, 1, 1);
	g0 = peek(prio, 0, 0);
	cons = speed - (cfrz ? 0 : 1);
	gdelay = gdelay - cfrac * cons;
	if (cons != 0) {
		duration = min(duration, MAXD / abs(cons));
	}
	if (cons > 0) {
		gdelay = max(gdelay, duration * cons);
	} else if (cons < 0) {
		gdelay = min(gdelay, MAXD + duration * cons);
	}
	if (pan < 0.5) {
		pn = pan * 2;
		poke(gr, amp, g0, 10);
		poke(gr, (1 - pn) * (1 + pn) * amp, g0, 11);
		poke(gr, 0, g0, 12);
		poke(gr, pn * (2 - pn) * amp, g0, 13);
	} else {
		pn = (1 - pan) * 2;
		poke(gr, pn * (2 - pn) * amp, g0, 10);
		poke(gr, 0, g0, 11);
		poke(gr, (1 - pn) * (1 + pn) * amp, g0, 12);
		poke(gr, amp, g0, 13);
	}
	// DelayGrain stores position and speed in fixed point (×1024, truncated) like the module
	poke(gr, trunc(gdelay * 1024) / 1024, g0, 8);
	lpos = gdelay / MAXD;
	lspd = speed;
	poke(gr, trunc(speed * 1024) / 1024, g0, 9);
	// GrainEnvelope::Start(duration, shape, fractional)
	sus = max(1 - 3 * shp, 0);
	at = (shp - 0.33333333) * 1.5;
	if (at < 0) {
		at = 0;
	} else if (at < 0.5) {
		at = at * at * at * 4;
	}
	re = (1 - at) * (1 - sus);
	ia = 1 / max(duration * at, 0.0005 * RG * (1 + 3 * sus));
	is = 1 / max(duration * sus, 2);
	ir = 1 / max(duration * re, 0.010 * RG);
	poke(gr, ia, g0, 2);
	poke(gr, is, g0, 3);
	poke(gr, ir, g0, 4);
	poke(gr, at < 0.5 ? 2 * at : 2 - 2 * at, g0, 5);
	gph = ia * cfrac;
	gst = 0;
	if (gph >= 1) {
		gph = (gph - 1) / ia * is;
		gst = 1;
	}
	poke(gr, gst, g0, 0);
	poke(gr, gph, g0, 1);
	poke(gr, trunc(duration), g0, 14);
	poke(gr, 1, g0, 6);
	poke(gr, 0, g0, 7);
	// SortGrainList (polyphonic)
	inst = trunc(RG * 0.005);
	pre = trunc(RG * 0.1);
	f0 = 1;
	f1 = 1;
	f2 = 1;
	f3 = 1;
	if (gint < trunc(RG * 0.025)) {
		first = peek(prio, 0, 0);
		for (k = 0; k < 31; k += 1) {
			poke(prio, peek(prio, k + 1, 0), k, 0);
		}
		poke(prio, first, 31, 0);
		f0 = gint + 1;
		f1 = inst;
		f2 = inst;
		f3 = pre;
		if (gint > inst) {
			tmp = f0;
			f0 = f2;
			f2 = tmp;
		}
	} else {
		for (k = 0; k < 4; k += 1) {
			poke(sum, k, 4, 0);
			poke(sum, peek(gr, peek(prio, k, 0), 14), 5, 0);
			for (j = k + 1; j < 32; j += 1) {
				rj = peek(gr, peek(prio, j, 0), 14);
				if (rj < peek(sum, 5, 0)) {
					poke(sum, j, 4, 0);
					poke(sum, rj, 5, 0);
				}
			}
			best = peek(sum, 4, 0);
			if (best != k) {
				tmp = peek(prio, k, 0);
				poke(prio, peek(prio, best, 0), k, 0);
				poke(prio, tmp, best, 0);
			}
		}
		f0 = inst;
		f1 = inst;
		f2 = gint;
		f3 = pre;
		if (gint > pre) {
			tmp = f2;
			f2 = f3;
			f3 = tmp;
		}
	}
	for (k = 0; k < 4; k += 1) {
		gk = peek(prio, k, 0);
		fd = k == 0 ? f0 : k == 1 ? f1 : k == 2 ? f2 : f3;
		fd = max(fd, 1);
		if (peek(gr, gk, 14) > fd) {
			poke(gr, 1 / fd, gk, 7);
			poke(gr, trunc(peek(gr, gk, 6) * fd), gk, 14);
		}
	}
	gint = 0;
}

// ---- render all grains (DelayGrain::Render<STOP, fade_out>)
poke(sum, 0, 0, 0);
poke(sum, 0, 1, 0);
poke(sum, 0, 2, 0);
for (k = 0; k < 32; k += 1) {
	stg = peek(gr, k, 0);
	vs = peek(gr, k, 6);
	if (stg < 2.5 && vs > 0) {
		poke(sum, peek(sum, 2, 0) + 1, 2, 0);
		dl = peek(gr, k, 8) - peek(gr, k, 9);
		if (!cfrz) {
			dl = dl + 1;
		}
		if (dl < 0 || dl >= MAXD) {
			dl = 0;
			stg = 3;
		}
		dd = abs(dl >= MAXD * 0.5 ? dl - MAXD : dl);
		fr = dd < 256 ? dd / 256 : 1;
		di = floor(dl);
		df = dl - di;
		idx = wrapi(w + di + MAXD - 1, MAXD);
		xl0 = bvalid(idx, nwr1, MAXD) > 0.5 ? peek(buf, idx, 0) : 0;
		xl1 = bvalid(idx + 1, nwr1, MAXD) > 0.5 ? peek(buf, idx + 1, 0) : 0;
		xl2 = bvalid(idx + 2, nwr1, MAXD) > 0.5 ? peek(buf, idx + 2, 0) : 0;
		xl3 = bvalid(idx + 3, nwr1, MAXD) > 0.5 ? peek(buf, idx + 3, 0) : 0;
		xr0 = bvalid(idx, nwr1, MAXD) > 0.5 ? peek(buf, idx, 1) : 0;
		xr1 = bvalid(idx + 1, nwr1, MAXD) > 0.5 ? peek(buf, idx + 1, 1) : 0;
		xr2 = bvalid(idx + 2, nwr1, MAXD) > 0.5 ? peek(buf, idx + 2, 1) : 0;
		xr3 = bvalid(idx + 3, nwr1, MAXD) > 0.5 ? peek(buf, idx + 3, 1) : 0;
		cl = (xl2 - xl0) * 0.5;
		vl = xl1 - xl2;
		wl = cl + vl;
		al = wl + vl + (xl3 - xl1) * 0.5;
		yl = (((al * df) - (wl + al)) * df + cl) * df + xl1;
		cr = (xr2 - xr0) * 0.5;
		vr = xr1 - xr2;
		wr = cr + vr;
		ar = wr + vr + (xr3 - xr1) * 0.5;
		yr = (((ar * df) - (wr + ar)) * df + cr) * df + xr1;
		ffr = sstep(fr);
		// GrainEnvelope::Render
		env = 0;
		gph = peek(gr, k, 1);
		if (stg < 2.5) {
			if (stg > 0.5 && stg < 1.5) {
				env = 1;
			} else {
				tt = stg < 0.5 ? gph : 1 - gph;
				bs = stg < 0.5 ? tt : tt * tt * tt * tt;
				env = bs + (sstep(tt) - bs) * peek(gr, k, 5);
			}
			inc = peek(gr, k, 2 + stg);
			gph = gph + inc;
			if (gph >= 1) {
				t2 = (gph - 1) / inc;
				stg = stg + 1;
				gph = stg < 2.5 ? t2 * peek(gr, k, 2 + stg) : 0;
			}
		}
		vs = vs - peek(gr, k, 7);
		genv = env * max(vs, 0) * ffr;
		poke(sum, peek(sum, 0, 0) + (yl * peek(gr, k, 10) + yr * peek(gr, k, 11)) * genv, 0, 0);
		poke(sum, peek(sum, 1, 0) + (yl * peek(gr, k, 12) + yr * peek(gr, k, 13)) * genv, 1, 0);
		rem = peek(gr, k, 14) - 1;
		if (stg > 2.5 || vs <= 0) {
			rem = 0;
		}
		poke(gr, stg, k, 0);
		poke(gr, gph, k, 1);
		poke(gr, vs, k, 6);
		poke(gr, dl, k, 8);
		poke(gr, rem, k, 14);
	}
}
gint = gint + 1;
outl = peek(sum, 0, 0);
outr = peek(sum, 1, 0);
nplay = peek(sum, 2, 0);

// ---- feedback path: DC blocker (Svf HP 40 Hz, q 0.5) → one-pole
fhp = 40 / RG;
gg = fhp * (pi + fhp * fhp * (0.326 * pi * pi * pi + 0.1823 * pi * pi * pi * pi * pi * fhp * fhp));
hh = 1 / (1 + 2 * gg + gg * gg);
h1 = cfresh ? 0 : hp1;
h2 = cfresh ? 0 : hp2;
q1 = cfresh ? 0 : hq1;
q2 = cfresh ? 0 : hq2;
hpl = (outl - 2 * h1 - gg * h1 - h2) * hh;
bpl = gg * hpl + h1;
n_hp1 = gg * hpl + bpl;
lpl = gg * bpl + h2;
n_hp2 = gg * bpl + lpl;
hpr = (outr - 2 * q1 - gg * q1 - q2) * hh;
bpr = gg * hpr + q1;
n_hq1 = gg * hpr + bpr;
lpr = gg * bpr + q2;
n_hq2 = gg * bpr + lpr;
// one-pole into previous_sample_: 0.999 (16-bit), 0.9 (12-bit), 0.75 (8-bit)
fblp = qi < 0.5 ? 0.999 : qi < 2.5 ? 0.9 : 0.75;
n_prev_l = pvl + fblp * (hpl - pvl);
n_prev_r = pvr + fblp * (hpr - pvr);
// results out of the core
poke(cx, outl, 12, 0);
poke(cx, outr, 13, 0);
poke(cx, nplay, 3, 0);
poke(cx, w / MAXD, 4, 0);
poke(cx, lpos, 5, 0);
poke(cx, lspd, 6, 0);
// core state write-back
nh_wp = w;
nh_nwr = nwr1;
nh_interval = gint;
nh_lastpos = lpos;
nh_lastspd = lspd;
nh_prev_l = n_prev_l;
nh_prev_r = n_prev_r;
nh_hp1 = n_hp1;
nh_hp2 = n_hp2;
nh_hq1 = n_hq1;
nh_hq2 = n_hq2;
nh_lim_in_p = li_p;
nh_lim_in_lp = li_lp;
nh_was_frozen = cfrz;
nh_tail_wp = twp;
nh_tail_xf = txf;
nh_s_fb = fbk;
nh_i_fb = inc_fb;
}

if (rat > 1.5 && gtick) {
	nguw = wrapi(guw + 1, 32);
	poke(gup, peek(cx, 12, 0), nguw, 0);
	poke(gup, peek(cx, 13, 0), nguw, 1);
}
wetl = rat > 1.5 ? upl : peek(cx, 12, 0);
wetr = rat > 1.5 ? upr : peek(cx, 13, 0);

// ---- dry / wet (Processor::Process)
dw = clamp(st_dwk * 1.005 + (dst_drywet > 0.5 ? cv_a2 * dw_amt : 0), 0, 1);
dry_t = (1 - dw) * (1 + dw) * 0.75;
wet_t = dw * (2 - dw) * 1.5;
inc_dry = newblk ? (dry_t - s_dry) / BLK : i_dry;
inc_wet = newblk ? (wet_t - s_wet) / BLK : i_wet;
dry = s_dry + inc_dry;
wet = s_wet + inc_wet;
// the dry signal through the quality's converter: 12-bit truncation (Cold digital), µ-law (Scorched cassette)
dryl = qi > 0.5 && qi < 1.5 ? trunc(inl * 4096) / 4096 : qi > 2.5 ? mulaw(inl) : inl;
dryr = qi > 0.5 && qi < 1.5 ? trunc(inr * 4096) / 4096 : qi > 2.5 ? mulaw(inr) : inr;
ml = dry * dryl + wet * wetl;
mr = dry * dryr + wet * wetr;

// ---- wow & flutter (Scorched cassette only; WowAndFlutter::Init(24000), set_lp(0.95), amount 1)
wrph = wf_rph;
wrf = init < 0.5 ? 0.125 / 24000 : wf_rf;
wwph = wf_wph;
wfph = wf_fph;
wdel = wf_del;
winc = wf_inc;
wpend = wf_pend;
wlpl = wf_lpl;
wlpr = wf_lpr;
wwp = wf_w;
if (qi > 2.5) {
	if (newblk) {
		pph = wrph;
		wrph = wrph + wrf * BLK;
		wrph = wrph >= 1 ? wrph - 1 : wrph;
		wrm = 0.5 + 0.5 * lsin(wrph);
		// the new random rate is drawn after the grains of this block (see the end of the codec stage)
		wpend = wrph >= 0.25 && pph < 0.25;
		fm = 0.5 + 1.5 * wrm * wrm;
		wam = 1 - 0.4 * wrm;
		wwph = wwph + (1 / 24000) * 0.23 * BLK * fm;
		wwph = wwph >= 1 ? wwph - 1 : wwph;
		wfph = wfph + (1 / 24000) * 1.99 * BLK;
		wfph = wfph >= 1 ? wfph - 1 : wfph;
		wdt = 1 + (105 * (0.5 + 0.5 * lsin(wwph)) + 17 * (0.5 + 0.5 * lsin(wfph))) * wam;
		winc = (wdt - wdel) / BLK;
	}
	wdel = wdel + winc;
	poke(wfl, ml, wwp, 0);
	poke(wfl, mr, wwp, 1);
	wwp = wrapi(wwp - 1, 128);
	wdi = trunc(wdel);
	wdf = wdel - wdi;
	wa = peek(wfl, wrapi(wwp + wdi, 128), 0);
	wlpl = wlpl + 0.95 * (wa + (peek(wfl, wrapi(wwp + wdi + 1, 128), 0) - wa) * wdf - wlpl);
	wa = peek(wfl, wrapi(wwp + wdi, 128), 1);
	wlpr = wlpr + 0.95 * (wa + (peek(wfl, wrapi(wwp + wdi + 1, 128), 1) - wa) * wdf - wlpr);
	ml = wlpl;
	mr = wlpr;
	if (blkc > BLK - 1.5 && wpend) {
		wrf = (1 / 24000) * (0.05 + rnd() * 0.2);
		wpend = 0;
	}
}

// ---- pre-reverb limiter (decay 1/(4 sr), 0.9)
pk = min(max(abs(ml), abs(mr)), 40);
lpp0 = fresh ? 0.5 : lim_pre_p;
lplp0 = fresh ? 0.5 : lim_pre_lp;
e1 = pk - lpp0;
lp_p = lpp0 + (e1 > 0 ? 0.1 : 1 / (FS * 4)) * e1;
e2 = lp_p - lplp0;
lp_lp = lplp0 + (e2 > 0 ? 0.5 : 1 / (FS * 4)) * e2;
lg = lp_lp <= 0.9 ? 1 : 0.9 / lp_lp;
ml = ml * lg;
mr = mr * lg;

// ---- reverb (Griesinger / Dattorro topology, FxEngine 16-bit, 32768 words)
rva = clamp(st_rvk * 1.005 + (dst_reverb > 0.5 ? cv_a3 * rv_amt : 0), 0, 1);
rmix = rva * rva * 0.9;
// processor.cc: "caveman" reverb for every quality but Pristine: time 0.45 + 0.5 r³, lp 0.4
// (its 0.75 branch for MEDIA_VINTAGE_DIGITAL is unreachable: caveman already includes it)
rtime = qi > 0.5 ? 0.45 + 0.5 * rva * rva * rva : 0.3 + 0.6 * rva * rva * rva;
rlp = qi > 0.5 ? 0.4 : 0.6;
ig = 0.2 * (1 - 0.333 * rtime);
ssq = rmix * (2 - rmix);
inc_rd = newblk ? ((1 - rmix) * (1 + rmix) - rv_dry) / BLK : i_rd;
inc_rw = newblk ? (0.4 / ig - rv_wet) / BLK : i_rw;
inc_rs = newblk ? (ssq * (2 - ssq) * ig - rv_send) / BLK : i_rs;
r_dry = rv_dry + inc_rd;
r_wet = rv_wet + inc_rw;
r_send = rv_send + inc_rs;
rw = rv_wp - 1;
if (rw < 0) {
	rw = rw + 32768;
}
// stmlib CosineOscillator (approximate), 0.5 Hz / 0.3 Hz × 32, updated every 32 samples.
// Start(): y1 = c·0.25, y0 = 0.5 → value() = y1 + 0.5 until the first update.
c1 = 16 * (0.25 - 0.5 / FS * 32) * (1 - 2 * (0.25 - 0.5 / FS * 32));
c2 = 16 * (0.25 - 0.3 / FS * 32) * (1 - 2 * (0.25 - 0.3 / FS * 32));
y10 = fresh ? 0.5 : l1y0;
y11 = fresh ? c1 * 0.25 : l1y1;
y20 = fresh ? 0.5 : l2y0;
y21 = fresh ? c2 * 0.25 : l2y1;
lv1 = fresh ? c1 * 0.25 + 0.5 : l1v;
lv2 = fresh ? c2 * 0.25 + 0.5 : l2v;
if (wrapi(rw, 32) < 0.5) {
	tmp = y10;
	y10 = c1 * y10 - y11;
	y11 = tmp;
	lv1 = tmp + 0.5;
	tmp = y20;
	y20 = c2 * y20 - y21;
	y21 = tmp;
	lv2 = tmp + 0.5;
}
kap = 0.625;
// smear AP1: interpolate at 10 + 80*lfo1, write at 100
o = 10 + 80 * lv1;
oi = floor(o);
of = o - oi;
ra = peek(rv, wrapi(rw + oi, 32768), 0);
rb = peek(rv, wrapi(rw + oi + 1, 32768), 0);
acc = ra + (rb - ra) * of;
poke(rv, q16(acc), wrapi(rw + 100, 32768), 0);
acc = (ml + mr) * r_send;
// 4 diffusers: base/length 0/150, 151/214, 366/319, 686/527
pr = peek(rv, wrapi(rw + 149, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 151 + 213, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 151, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 366 + 318, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 366, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 686 + 526, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 686, 32768), 0);
acc = acc * -kap + pr;
apout = acc;
// left loop: del2 (15314/6312) → lp → dap1a (1214/2182) → dap1b (3397/2690) → del1 (6088/4501)
o = 6261 + 50 * lv2;
oi = floor(o);
of = o - oi;
ra = peek(rv, wrapi(rw + oi + 15314, 32768), 0);
rb = peek(rv, wrapi(rw + oi + 15315, 32768), 0);
acc = apout + (ra + (rb - ra) * of) * rtime;
lp1 = rv_lp1 + rlp * (acc - rv_lp1);
acc = lp1;
pr = peek(rv, wrapi(rw + 1214 + 2181, 32768), 0);
acc = acc + pr * -kap;
poke(rv, q16(acc), wrapi(rw + 1214, 32768), 0);
acc = acc * kap + pr;
pr = peek(rv, wrapi(rw + 3397 + 2689, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 3397, 32768), 0);
acc = acc * -kap + pr;
poke(rv, q16(acc), wrapi(rw + 6088, 32768), 0);
wl_ = acc;
// right loop: del1 → lp → dap2a (10590/2525) → dap2b (13116/2197) → del2
o = 4460 + 40 * lv1;
oi = floor(o);
of = o - oi;
ra = peek(rv, wrapi(rw + oi + 6088, 32768), 0);
rb = peek(rv, wrapi(rw + oi + 6089, 32768), 0);
acc = apout + (ra + (rb - ra) * of) * rtime;
lp2 = rv_lp2 + rlp * (acc - rv_lp2);
acc = lp2;
pr = peek(rv, wrapi(rw + 10590 + 2524, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 10590, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 13116 + 2196, 32768), 0);
acc = acc + pr * -kap;
poke(rv, q16(acc), wrapi(rw + 13116, 32768), 0);
acc = acc * kap + pr;
poke(rv, q16(acc), wrapi(rw + 15314, 32768), 0);
wr_ = acc;
ml = ml * r_dry + wl_ * r_wet;
mr = mr * r_dry + wr_ * r_wet;

// ---- output limiter (decay 1/(6 sr), 0.9) and output gain
pk = min(max(abs(ml), abs(mr)), 40);
lop0 = fresh ? 0.5 : lim_out_p;
lolp0 = fresh ? 0.5 : lim_out_lp;
e1 = pk - lop0;
lo_p = lop0 + (e1 > 0 ? 0.1 : 1 / (FS * 6)) * e1;
e2 = lo_p - lolp0;
lo_lp = lolp0 + (e2 > 0 ? 0.5 : 1 / (FS * 6)) * e2;
lg = lo_lp <= 0.9 ? 1 : 0.9 / lo_lp;
// FLØCK (not Beads): AUTO gain normalises what the engine hears; the output returns to the input level
ocomp = agc > 0.5 ? 1 / ggain : 1;
poke(cx, ml * lg * outgain * ocomp, 0, 0);
poke(cx, mr * lg * outgain * ocomp, 1, 0);
poke(cx, trig, 2, 0);
poke(cx, sstp, 7, 0);
poke(cx, running, 8, 0);
poke(cx, ggain, 9, 0);
poke(cx, learning, 10, 0);

// ---- state write-back (all History writes at the end of the pass)
nh_init = 1;
nh_s_time = st_time;
nh_s_size = st_size;
nh_s_shape = st_shape;
nh_s_pitch = st_pitch;
nh_s_tamt = st_tamt;
nh_s_samt = st_samt;
nh_s_hamt = st_hamt;
nh_s_pamt = st_pamt;
nh_s_dens = st_dens;
nh_s_timeh = st_timeh;
nh_s_fbk = st_fbk;
nh_s_dwk = st_dwk;
nh_s_rvk = st_rvk;
nh_s_dry = dry;
nh_s_wet = wet;
nh_tg_phase = ph;
nh_tg_ratio = ratio;
nh_tg_freq = tapf;
nh_tg_elapsed = tg_el;
nh_prev_gate = npg;
nh_prev_ext = egate;
nh_g_peak = npeak;
nh_g_agc = gagc;
nh_g_stable = gstb;
nh_g_gain = ggain;
nh_g_inc = ginc;
nh_g_time = gtime;
nh_g_rst = agc_restart;
nh_sdw = nsdw;
nh_sdn = nsdn;
nh_lim_pre_p = lp_p;
nh_lim_pre_lp = lp_lp;
nh_lim_out_p = lo_p;
nh_lim_out_lp = lo_lp;
nh_rv_wp = rw;
nh_rv_lp1 = lp1;
nh_rv_lp2 = lp2;
nh_rv_dry = r_dry;
nh_rv_wet = r_wet;
nh_rv_send = r_send;
nh_blk = nblk;
nh_i_dry = inc_dry;
nh_i_wet = inc_wet;
nh_i_rd = inc_rd;
nh_i_rw = inc_rw;
nh_i_rs = inc_rs;
nh_l1y0 = y10;
nh_l1y1 = y11;
nh_l2y0 = y20;
nh_l2y1 = y21;
nh_l1v = lv1;
nh_prev_bp = bp;
nh_bar_cnt = nbars;
nh_was_run = running;
nh_l1_ph = l1f;
nh_l2_ph = l2f;
nh_rn_ph = rnf;
nh_rn_pph = rnf;
nh_rn_seed = nseed;
nh_rn_from = nfrom;
nh_rn_to = nto;
nh_env_st = nenv;
nh_ck_ph = ckf;
nh_c_t = cv_t;
nh_c_s = cv_s;
nh_c_h = cv_h;
nh_c_p = cv_p;
nh_c_d = cv_d;
nh_c_a1 = cv_a1;
nh_c_a2 = cv_a2;
nh_c_a3 = cv_a3;
nh_tg_target = tgt;
nh_tg_lpc = lpc;
nh_tg_audio = aud;
nh_tg_accept = acc_p;
nh_tg_count = pcount;
nh_tg_resetint = rint;
nh_tg_quant = quant;
nh_tg_div = ndiv;
nh_l2v = lv2;
nh_c_rc = FS;
nh_crst = gtick ? 0 : ncrst;
nh_gdw = ngdw;
nh_guw = nguw;
nh_pt = (rat > 1.5 && !gtick) ? trig : 0;
nh_pf = frac;
nh_preg = regularity;
nh_pfz = (rat > 1.5 && !gtick) ? frozen : 0;
nh_s_sca = sca;
nh_i_sca = isca;
nh_wf_rph = wrph;
nh_wf_rf = wrf;
nh_wf_wph = wwph;
nh_wf_fph = wfph;
nh_wf_del = wdel;
nh_wf_inc = winc;
nh_wf_lpl = wlpl;
nh_wf_lpr = wlpr;
nh_wf_w = wwp;
nh_wf_pend = wpend;
}
// ================================================================ host output
new_ = ew;
o1 = peek(cx, 0, 0);
o2 = peek(cx, 1, 0);
if (rsm) {
	if (ctk) {
		new_ = wrapi(ew + 1, 64);
		poke(eo, peek(cx, 0, 0), new_, 0);
		poke(eo, peek(cx, 1, 0), new_, 1);
	}
	// up-converter: the same kernel, read 16 codec samples back (latency), weights normalised
	poke(acs, 0, 0, 0);
	poke(acs, 0, 1, 0);
	poke(acs, 0, 2, 0);
	for (k = 0; k < 33; k += 1) {
		ka = abs(16 - dlt - k) * 256;
		ki = floor(ka);
		if (ki < 4096) {
			wk = peek(ck, ki, 0) + (peek(ck, ki + 1, 0) - peek(ck, ki, 0)) * (ka - ki);
			poke(acs, peek(acs, 0, 0) + peek(eo, wrapi(new_ - k, 64), 0) * wk, 0, 0);
			poke(acs, peek(acs, 1, 0) + peek(eo, wrapi(new_ - k, 64), 1) * wk, 1, 0);
			poke(acs, peek(acs, 2, 0) + wk, 2, 0);
		}
	}
	o1 = ckok ? peek(acs, 0, 0) / peek(acs, 2, 0) : 0;
	o2 = ckok ? peek(acs, 1, 0) / peek(acs, 2, 0) : 0;
}
out1 = o1;
out2 = o2;
out3 = ctk ? peek(cx, 2, 0) : 0;
out4 = peek(cx, 3, 0);
out5 = peek(cx, 4, 0);
out6 = peek(cx, 5, 0);
out7 = peek(cx, 6, 0);
out8 = peek(cx, 7, 0);
out9 = peek(cx, 8, 0);
out10 = peek(cx, 9, 0);
out11 = peek(cx, 10, 0);
out12 = tapev;
out13 = ctk ? tapei : -1;
hinit = 1;
ckn = nckn;
qc = qi;
cacc = nacc;
hw = nhw;
ew = new_;
wp = nh_wp;
nwr = nh_nwr;
sdn = nh_sdn;
interval = nh_interval;
lastpos = nh_lastpos;
lastspd = nh_lastspd;
prev_l = nh_prev_l;
prev_r = nh_prev_r;
hp1 = nh_hp1;
hp2 = nh_hp2;
hq1 = nh_hq1;
hq2 = nh_hq2;
lim_in_p = nh_lim_in_p;
lim_in_lp = nh_lim_in_lp;
was_frozen = nh_was_frozen;
tail_wp = nh_tail_wp;
tail_xf = nh_tail_xf;
s_fb = nh_s_fb;
i_fb = nh_i_fb;
init = nh_init;
s_time = nh_s_time;
s_size = nh_s_size;
s_shape = nh_s_shape;
s_pitch = nh_s_pitch;
s_tamt = nh_s_tamt;
s_samt = nh_s_samt;
s_hamt = nh_s_hamt;
s_pamt = nh_s_pamt;
s_dens = nh_s_dens;
s_timeh = nh_s_timeh;
s_fbk = nh_s_fbk;
s_dwk = nh_s_dwk;
s_rvk = nh_s_rvk;
s_dry = nh_s_dry;
s_wet = nh_s_wet;
tg_phase = nh_tg_phase;
tg_ratio = nh_tg_ratio;
tg_freq = nh_tg_freq;
tg_elapsed = nh_tg_elapsed;
prev_gate = nh_prev_gate;
prev_ext = nh_prev_ext;
g_peak = nh_g_peak;
g_agc = nh_g_agc;
g_stable = nh_g_stable;
g_gain = nh_g_gain;
g_inc = nh_g_inc;
g_time = nh_g_time;
g_rst = nh_g_rst;
sdw = nh_sdw;
lim_pre_p = nh_lim_pre_p;
lim_pre_lp = nh_lim_pre_lp;
lim_out_p = nh_lim_out_p;
lim_out_lp = nh_lim_out_lp;
rv_wp = nh_rv_wp;
rv_lp1 = nh_rv_lp1;
rv_lp2 = nh_rv_lp2;
rv_dry = nh_rv_dry;
rv_wet = nh_rv_wet;
rv_send = nh_rv_send;
blk = nh_blk;
i_dry = nh_i_dry;
i_wet = nh_i_wet;
i_rd = nh_i_rd;
i_rw = nh_i_rw;
i_rs = nh_i_rs;
l1y0 = nh_l1y0;
l1y1 = nh_l1y1;
l2y0 = nh_l2y0;
l2y1 = nh_l2y1;
l1v = nh_l1v;
prev_bp = nh_prev_bp;
bar_cnt = nh_bar_cnt;
was_run = nh_was_run;
l1_ph = nh_l1_ph;
l2_ph = nh_l2_ph;
rn_ph = nh_rn_ph;
rn_pph = nh_rn_pph;
rn_seed = nh_rn_seed;
rn_from = nh_rn_from;
rn_to = nh_rn_to;
env_st = nh_env_st;
ck_ph = nh_ck_ph;
c_t = nh_c_t;
