// FLØCK engine — gen~ codebox (GenExpr): granular mode with the four recording qualities.
//
// Port of the Beads DSP by Emilie Gillet (Mutable Instruments), MIT licence:
//   Copyright 2017 Emilie Gillet. Permission is hereby granted, free of charge, to any person
//   obtaining a copy of this software ... (full text: flock/LICENSE-BEADS.txt).
// Files ported here: beads/dsp/processor.cc, granular_processor.h, granular_player.h,
// delay_granular_player.h, delay_grain.h, grain_envelope.h, voice_stealing_envelope.h,
// delay_line.h (16 / 12-bit / µ-law items, Hermite read, freeze tail), mu_law.cc,
// fx/wow_and_flutter.h, trigger_generator.cc, randomized_parameter.h, limiter.h, fx/reverb.h +
// fx_engine.h, cv_reader.h (pot laws), gain_control.cc, stmlib SoftClip / Svf / CosineOscillator.
//
// Qualities (v0.4.1): everything runs at the host rate. The module's codec rates (32 / 24 kHz) are
// represented by the codec bandwidth (two one-poles at 14 / 10 kHz on the input) and wow & flutter
// converted to the host rate. The exact codec-rate structure of v0.3 did not run in Max
// (docs/PORTING_NOTES.md, diagnostic kits 4–8). Built from tools/lite_qualities.py; edit HERE now.
// Deviations: docs/PORTING_NOTES.md.
//
// Inlets : in1 L, in2 R, in3..in6 CV for TIME, SIZE, SHAPE, PITCH (MOD matrix; used if *_cv = 1)
// Outlets: out1 L, out2 R, out3 grain trigger (1 sample), out4 active grains, out5 write position 0..1,
//          out6 start of the latest grain (samples behind the head / buffer), out7 its speed (signed),
//          out8 sequencer step, out9 Live transport running (bar phase moving), out10 input gain,
//          out11 auto gain learning, out12 buffer filled 0..1, out13 reserved (-1)
//          in7 bar phase from Live (phasor~ 1n @lock 1); in8..in11 external SEED / FREEZE / DENSITY / assign
//          (destination index 7, used by the tests)
//
// Written in the subset that tools/genexpr.js can run and lint (see that file).

// gen~ rule (Max 9.1): function definitions come before any Param / Data / History.
sstep(x) {
	return x * x * (3 - 2 * x);
}
interval_st(n) {
	return n < 0.5 ? 0 : n < 1.5 ? 1 : n < 2.5 ? 3 : n < 3.5 ? 4 : n < 4.5 ? 7 : n < 5.5 ? 12 : 24;
}
attenu_law(k) {
	v = k - 0.5;
	return (2 / 0.47) * v * max(abs(v) - 0.03, 0);
}
detune_law(k) {
	d = 2 * k - 1;
	sg = d < 0 ? -1 : 1;
	d = d * sg * 6;
	di = floor(d);
	df = d - di;
	df = max((df - 0.33333333) * 1.5, 0);
	a = interval_st(di);
	b = interval_st(di + 1);
	return (a + (b - a) * sstep(df)) * sg;
}
q16(x) {
	return clamp(trunc(x * 32768), -32768, 32767) / 32768;
}
rnd() {
	return (noise() + 1) * 0.5;
}
// RandomizedParameter::value(NULL, 0, range, clamp)
rparam(base, att, cv, hascv, range, clampit) {
	res = base;
	if (hascv < 0.5) {
		blend = att > 0 ? att : min(1, att * rnd() * -3);
		rval = clampit > 0.5 ? rnd() * range - res : (2 * rnd() - 1) * range;
		res = res + rval * blend;
	} else {
		if (att < 0) {
			u = rnd();
			res = res + max(cv, 0) * -att * (u * (u * (4 * u - 6) + 4) - 1);
		} else {
			res = res + att * cv;
		}
	}
	return clampit > 0.5 ? clamp(res, 0, 1) : res;
}
ramount(att, hascv) {
	return hascv > 0.5 ? max(-att, 0) : abs(att);
}
// tempo divisions per bar: 8 bars, 4 bars, 2 bars, 1 bar, 1/2, 1/4D, 1/2T, 1/4, 1/8D, 1/4T, 1/8, 1/8T, 1/16, 1/16T, 1/32
divper(i) {
	return i < 0.5 ? 0.125 : i < 1.5 ? 0.25 : i < 2.5 ? 0.5 : i < 3.5 ? 1 : i < 4.5 ? 2 : i < 5.5 ? 2.6666667 : i < 6.5 ? 3 : i < 7.5 ? 4 : i < 8.5 ? 5.3333333 : i < 9.5 ? 6 : i < 10.5 ? 8 : i < 11.5 ? 12 : i < 12.5 ? 16 : i < 13.5 ? 24 : 32;
}
lfo_shape(ph, shp) {
	return shp < 0.5 ? sin(twopi * ph) : shp < 1.5 ? (ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph) : shp < 2.5 ? 1 - 2 * ph : (ph < 0.5 ? 1 : -1);
}
// source 1..6: LFO 1, LFO 2, RANDOM, ENV, CLOCK, SEQ ; 7 = external inlet (tests / future)
pick(i, a, b, c, d, v5, v6, x) {
	return i < 0.5 ? 0 : i < 1.5 ? a : i < 2.5 ? b : i < 3.5 ? c : i < 4.5 ? d : i < 5.5 ? v5 : i < 6.5 ? v6 : x;
}
// the module's division table for the clocked SEED (kDivisionRatios)
divratio(q) {
	return q < 0.5 ? 1 : q < 1.5 ? 2 : q < 2.5 ? 3 : q < 3.5 ? 4 : q < 4.5 ? 6 : q < 5.5 ? 8 : q < 6.5 ? 12 : 16;
}
wrapi(x, n) {
	return x - floor(x / n) * n;
}

q12(x) {
	return floor(clamp(trunc(x * 32768), -32768, 32767) / 16) / 2048;
}

mulaw(x) {
	cq = clamp(trunc(x * 32768), -32768, 32767);
	pq = floor(cq / 4);
	ng = pq < 0;
	mq = min(ng ? -pq : pq, 8159) + 33;
	seg = mq <= 63 ? 0 : mq <= 127 ? 1 : mq <= 255 ? 2 : mq <= 511 ? 3 : mq <= 1023 ? 4 : mq <= 2047 ? 5 : mq <= 4095 ? 6 : mq <= 8191 ? 7 : 8;
	man = seg > 7.5 ? 15 : wrapi(floor(mq / pow(2, seg + 1)), 16);
	tq = (man * 8 + 132) * pow(2, min(seg, 7)) - 132;
	return floor((ng ? -tq : tq) / 32768 * 100000 + 0.5) / 100000;
}

soft_limit(x) {
	return x * (27 + x * x) / (27 + 9 * x * x);
}

sclip(x) {
	return x < -3 ? -1 : x > 3 ? 1 : soft_limit(x);
}

lsin(ph0) {
	xq = ph0 * 1024;
	ix = trunc(xq);
	return sin(twopi * ix / 1024) + (sin(twopi * (ix + 1) / 1024) - sin(twopi * ix / 1024)) * (xq - ix);
}

bvalid(i, n, m) {
	ii = i >= m ? i - m : i;
	return n > m ? 1 : ii < 0.5 ? n >= 1 : n - 1 >= m - ii;
}

// soft knee: linear below 0.9, then tanh up to 1.0
sknee(x) {
	ax = abs(x);
	return ax < 0.9 ? x : (x < 0 ? -1 : 1) * (0.9 + 0.1 * tanh((ax - 0.9) / 0.1));
}

Param time(0.15, min=0, max=1);
Param size(0.6, min=0, max=1);
Param shape(0.6, min=0, max=1);
Param pitch(0.5, min=0, max=1);
Param time_amt(0.75, min=0, max=1);
Param size_amt(0.5, min=0, max=1);
Param shape_amt(0.5, min=0, max=1);
Param pitch_amt(0.5, min=0, max=1);
Param time_cv(0, min=0, max=1);
Param size_cv(0, min=0, max=1);
Param shape_cv(0, min=0, max=1);
Param pitch_cv(0, min=0, max=1);
Param density(0.12, min=0, max=1);
Param feedback(0.1, min=0, max=1);
Param drywet(0.7, min=0, max=1);
Param reverb(0.35, min=0, max=1);
Param freeze(0, min=0, max=1);
Param seed(0, min=0, max=1);
Param seedlatch(1, min=0, max=1);
Param ingain(1, min=0, max=40);
Param outgain(1, min=0, max=4);
// Beads GainControl: automatic input gain (learns 1 s + 5 s, then follows slowly), ×1 … ×40;
// agc = 0 → manual gain `ingain`. agc_restart: any new value restarts the learning (LEARN).
Param agc(0, min=0, max=1);
Param quality(0, min=0, max=3);
// MIDI keys (FLØCK Keys device): ktrig = a key is held (fires grains like SEED), knote = semitones
// from C3 added to PITCH while kon = 1 (FLØCK, not Beads)
Param ktrig(0, min=0, max=1);
Param knote(0, min=-48, max=48);
Param kon(0, min=0, max=1);
Param agc_restart(0, min=0, max=1000000);
// DENSITY CV depth (FLØCK; Beads has none = 1)
Param dn_amt(0.5, min=0, max=1);
// ---- modulation (MOD tab). Destinations take a source index: 0 none, 1 LFO1, 2 LFO2, 3 RANDOM,
// 4 ENV, 5 CLOCK, 6 SEQ, 7 external inlet (in8..in11, tests / future)
Param dst_freeze(0, min=0, max=7);
Param dst_seed(0, min=0, max=7);
Param dst_time(0, min=0, max=7);
Param dst_pitch(0, min=0, max=7);
Param dst_size(0, min=0, max=7);
Param dst_shape(0, min=0, max=7);
Param dst_density(0, min=0, max=7);
Param dst_feedback(0, min=0, max=7);
Param dst_reverb(0, min=0, max=7);
Param dst_drywet(0, min=0, max=7);
Param fb_amt(1, min=0, max=1);
Param dw_amt(1, min=0, max=1);
Param rv_amt(1, min=0, max=1);
Param l1_rate(0.4, min=0, max=1);
Param l1_sync(0, min=0, max=1);
Param l1_shape(0, min=0, max=3);
Param l1_reset(0, min=0, max=1);
Param l1_amt(1, min=0, max=1);
Param l2_rate(0.25, min=0, max=1);
Param l2_sync(0, min=0, max=1);
Param l2_shape(1, min=0, max=3);
Param l2_reset(0, min=0, max=1);
Param l2_amt(1, min=0, max=1);
Param rn_rate(0.4, min=0, max=1);
Param rn_sync(0, min=0, max=1);
Param rn_smooth(1, min=0, max=1);
Param rn_amt(1, min=0, max=1);
Param env_gain(0.5, min=0, max=1);
Param ck_rate(0.857, min=0, max=1);
Param ck_sync(1, min=0, max=1);
Param sq_div(12, min=0, max=14);
Param sq_len(16, min=1, max=16);
// sequencer steps: value 0..1, negative = step off
Param sq0(1, min=-1, max=1);
Param sq1(-1, min=-1, max=1);
Param sq2(-1, min=-1, max=1);
Param sq3(-1, min=-1, max=1);
Param sq4(0.25, min=-1, max=1);
Param sq5(-1, min=-1, max=1);
Param sq6(-1, min=-1, max=1);
Param sq7(-1, min=-1, max=1);
Param sq8(0.5, min=-1, max=1);
Param sq9(-1, min=-1, max=1);
Param sq10(0.75, min=-1, max=1);
Param sq11(-1, min=-1, max=1);
Param sq12(0.625, min=-1, max=1);
Param sq13(-1, min=-1, max=1);
Param sq14(-1, min=-1, max=1);
Param sq15(-1, min=-1, max=1);

Data buf(768004, 2);
Data gr(32, 16);
Data prio(32, 1);
Data ftail(256, 2);
Data rv(32768, 1);
Data sum(8, 1);
Data wfl(1024, 2);
Data sdl(1024, 1);   // SEED input delay line (beads.cc event_delay: 10 blocks = 2.5 ms)   // per-sample accumulators: 0 L, 1 R, 2 playing grains, 3 active count, 4 best, 5 best remaining

History init(0);
History wp(0);
History s_time(0.5);
History s_size(0.45);
History s_shape(0.5);
History s_pitch(0);
History s_tamt(0);
History s_samt(0);
History s_hamt(0);
History s_pamt(0);
History s_dens(0.3);
History s_timeh(0.5);
History s_fbk(0);
History s_dwk(0.5);
History s_rvk(0.2);
History s_fb(0);
History s_dry(0);
History s_wet(0);
History tg_phase(0);
History tg_ratio(1);
History tg_freq(0.0001);
History tg_elapsed(24000);
History prev_gate(0);
History interval(1);
History prev_l(0);
History prev_r(0);
History hp1(0);
History hp2(0);
History hq1(0);
History hq2(0);
History lim_in_p(0.5);
History lim_in_lp(0.5);
History lim_pre_p(0.5);
History lim_pre_lp(0.5);
History lim_out_p(0.5);
History lim_out_lp(0.5);
History was_frozen(0);
History tail_wp(0);
History tail_xf(0);
History rv_wp(0);
History rv_lp1(0);
History rv_lp2(0);
History rv_dry(0);
History rv_wet(0);
History rv_send(0);
// stmlib ParameterInterpolator: mix parameters move linearly over blocks of sr/4000 samples (12 at 48 kHz, like the module)
History blk(0);
History i_fb(0);
History i_dry(0);
History i_wet(0);
History i_rd(0);
History i_rw(0);
History i_rs(0);
History l1y0(0.5);
History l1y1(0.5);
History l2y0(0.5);
History l2y1(0.5);
History l1v(0.5);
History l2v(0.5);
History prev_bp(0);
History bar_cnt(0);
History was_run(0);
History l1_ph(0);
History l2_ph(0);
History rn_ph(0);
History rn_from(0);
History rn_to(0);
History rn_seed(22222);
History rn_pph(0);
History env_st(0);
History ck_ph(0);
History c_t(0);
History c_s(0);
History c_h(0);
History c_p(0);
History c_d(0);
History c_a1(0);
History c_a2(0);
History c_a3(0);
History tg_target(0.0001);
History tg_lpc(1);
History tg_audio(0);
History tg_accept(1);
History tg_count(0);
History tg_resetint(192000);
History tg_quant(0);
History tg_div(1);
History prev_ext(0);
History sdw(0);
History g_peak(0.5);
History g_agc(0.5);
History g_stable(0.5);
History g_gain(1);
History g_inc(0);
History g_time(0);
History g_rst(0);
History lastpos(0);
History lastspd(1);
History qc(0);
History nwr(0);
History s_sca(0);
History i_sca(0);
History bl1(0);
History bl2(0);
History br1(0);
History br2(0);
History wf_rph(0);
History wf_rf(0.0000052083333);
History wf_wph(0);
History wf_fph(0);
History wf_del(0);
History wf_inc(0);
History wf_lpl(0);
History wf_lpr(0);
History wf_w(0);
History wf_pend(0);

// ---------------------------------------------------------------- per sample
FS = samplerate;
qr0 = clamp(floor(quality + 0.5), 0, 3);
qi = (init > 0.5 && (freeze > 0.5 || was_frozen > 0.5)) ? qc : qr0;
qchg = init > 0.5 && qi != qc;
MAXD = qi < 0.5 ? 192000 : min(768000, floor((qi < 1.5 ? 8 : qi < 2.5 ? 10.6666667 : 16) * samplerate));
k = 0;
j = 0;
// one-time init of the grain priority list
if (init < 0.5) {
	for (k = 0; k < 32; k += 1) {
		poke(prio, k, k, 0);
		poke(gr, 3, k, 0);
		poke(gr, 1, k, 6);
	}
}

// ---- controls (pot laws + smoothing like the module's ADC low-pass; no glide on load)
// Like the module: pots are read once per block of sr/4000 samples (cv_reader.Read in the audio
// callback): law → one-pole 0.05 → hysteresis (TIME 0.001). On load: no glide from zero.
newblk = blk < 0.5;
// the module's audio block: kBlockRate = 4000 → sr / 4000 samples (12 at 48 kHz)
BLK = floor(FS / 4000 + 0.5);
nblk = blk > BLK - 1.5 ? 0 : blk + 1;
kp = init < 0.5 ? 1 : newblk ? 0.05 : 0;
st_time = s_time + (time - s_time) * kp;
th_err = st_time - s_timeh;
st_timeh = init < 0.5 ? st_time : th_err > 0.001 ? st_time - 0.001 : th_err < -0.001 ? st_time + 0.001 : s_timeh;
st_fbk = s_fbk + (feedback - s_fbk) * kp;
st_dwk = s_dwk + (drywet - s_dwk) * kp;
st_rvk = s_rvk + (reverb - s_rvk) * kp;
st_size = s_size + (size - s_size) * kp;
st_shape = s_shape + (shape - s_shape) * kp;
st_pitch = s_pitch + (detune_law(pitch) - s_pitch) * kp;
st_tamt = s_tamt + (attenu_law(time_amt) - s_tamt) * kp;
st_samt = s_samt + (attenu_law(size_amt) - s_samt) * kp;
st_hamt = s_hamt + (attenu_law(shape_amt) - s_hamt) * kp;
st_pamt = s_pamt + (attenu_law(pitch_amt) - s_pamt) * kp;
st_dens = s_dens + (density - s_dens) * kp;
seedstate = seedlatch > 0.5 ? 2 : (seed > 0.5 || ktrig > 0.5) ? 1 : 0;

// ---- tempo from Live: bar phase (phasor~ 1n @lock 1) on in7; bars counted modulo 24
bp = in7;
running = abs(bp - prev_bp) > 0;
nbars = bp < prev_bp - 0.5 ? (bar_cnt > 22.5 ? 0 : bar_cnt + 1) : bar_cnt;
started = running && was_run < 0.5;
// synced sources run 10 blocks ahead: the SEED input delay of the module (2.5 ms, kept for the
// CV-settling it gives) then lands their gates exactly on Live's grid
dph = running ? bp - prev_bp + (bp < prev_bp - 0.5 ? 1 : 0) : 0;
pos = nbars + bp + dph * floor(FS / 4000 + 0.5) * 10 + 0.000000001;   // + 1e-9 bar: exact grid points round up, not down
// ---- input gain (GainControl::Process): block rate for the learning, sample rate for the peak
g_ign = trunc(FS * 1);
g_act = trunc(FS * 6);
gtime = init < 0.5 ? 0 : (agc_restart != g_rst ? g_ign : g_time);
gagc = g_agc;
gstb = g_stable;
ginc = g_inc;
isca = i_sca;
if (newblk) {
	ghz = BLK / FS;
	gerr = g_peak - gagc;
	if (gtime < g_ign) {
		gagc = 0.5;
	} else if (gtime < g_act) {
		gagc = gagc + (gerr > 0 ? 10 * ghz : 2 * ghz) * gerr;
		gstb = gagc;
	} else {
		gagc = gagc + (gerr > 0 ? 5 * ghz : (g_peak > gstb ? 0.5 : 0.01) * ghz) * gerr;
	}
	gtime = (gtime > g_ign || g_peak > 0.001) ? min(gtime + BLK, g_act) : gtime;
	gopt = min(0.9 / min(gagc, 0.9), 40);
	gtarget = agc > 0.5 ? gopt : ingain;
	isca = ((qi > 2.5 ? 1 : qi > 1.5 ? clamp(2 * (ingain / gopt - 0.75), 0, 1) : 0) - s_sca) / BLK;
	ginc = (gtarget - g_gain) / BLK;
}
ggain = g_gain + ginc;
gpk = max(abs(in1), abs(in2));
gpe = gpk - g_peak;
npeak = g_peak + (gpe > 0 ? 0.1 : 2 / FS) * gpe;
sca = (agc < 0.5 && qi > 1.5) ? s_sca + isca : s_sca;
// the codec's bandwidth: Cold digital 32 kHz (≈14 kHz), Scorched cassette 24 kHz (≈10 kHz): two one-poles
bfc = qi > 0.5 && qi < 1.5 ? 14000 : 10000;
bc = 1 - exp(-twopi * bfc / FS);
bon = (qi > 0.5 && qi < 1.5) || qi > 2.5;
nbl1 = bl1 + bc * (in1 - bl1);
nbl2 = bl2 + bc * (nbl1 - bl2);
nbr1 = br1 + bc * (in2 - br1);
nbr2 = br2 + bc * (nbr1 - br2);
xl = (bon ? nbl2 : in1) * ggain;
xr = (bon ? nbr2 : in2) * ggain;
cll = clamp(xl, -1, 1);
clr = clamp(xr, -1, 1);
inl = agc > 0.5 ? xl : (qi > 1.5 ? cll + ((1 - 0.05) * sclip(xl + 0.05) - 0.05 - cll) * sca : cll);
inr = agc > 0.5 ? xr : (qi > 1.5 ? clr + ((1 - 0.05) * sclip(xr + 0.05) - 0.05 - clr) * sca : clr);
learning = agc > 0.5 && gtime < g_act;

// ---- sources (MOD tab)
l1d = divper(floor(l1_rate * 14 + 0.5));
l1f = fract(l1_ph + 0.02 * pow(1000, l1_rate) / FS);
l1f = (l1_reset > 0.5 && started) ? 0 : l1f;
s1 = lfo_shape(l1_sync > 0.5 ? fract(pos * l1d) : l1f, l1_shape) * l1_amt;
l2d = divper(floor(l2_rate * 14 + 0.5));
l2f = fract(l2_ph + 0.02 * pow(1000, l2_rate) / FS);
l2f = (l2_reset > 0.5 && started) ? 0 : l2f;
s2 = lfo_shape(l2_sync > 0.5 ? fract(pos * l2d) : l2f, l2_shape) * l2_amt;
// RANDOM: random walk like RandomWalkModulation (own generator, not the grains' random stream)
rnf = rn_sync > 0.5 ? fract(pos * divper(floor(rn_rate * 14 + 0.5))) : fract(rn_ph + 0.02 * pow(1000, rn_rate) / FS);
rnwrap = rnf < rn_pph || init < 0.5;   // also on load: start from a random value, not from 0
nseed = rnwrap ? wrapi(rn_seed * 1664525 + 1013904223, 4294967296) : rn_seed;
nfrom = rnwrap ? rn_to : rn_from;
nto = rnwrap ? nseed / 4294967296 * 2 - 1 : rn_to;
s3 = (rn_smooth > 0.5 ? nfrom + (nto - nfrom) * sstep(rnf) : nto) * rn_amt;
// ENV: follower of the input, gain ×0.25 … ×16
ein = max(abs(inl), abs(inr));
nenv = env_st + (ein - env_st) * (ein > env_st ? 1 - exp(-1 / (0.003 * FS)) : 1 - exp(-1 / (0.15 * FS)));
s4 = clamp(nenv * 0.25 * pow(64, env_gain), 0, 1);
// CLOCK: tempo division (sync) or 0.1 … 40 Hz
ckf = fract(ck_ph + 0.1 * pow(400, ck_rate) / FS);
ckp = ck_sync > 0.5 ? fract(pos * divper(floor(ck_rate * 14 + 0.5))) : ckf;
s5 = (ckp < 0.5 && (ck_sync < 0.5 || running)) ? 1 : 0;
// SEQ: steps at the tempo division, length 1..16; value 0..1, gate in the first half of an "on" step
spos = pos * divper(sq_div);
sstp = wrapi(floor(spos), floor(sq_len));
sval = sstp < 0.5 ? sq0 : sstp < 1.5 ? sq1 : sstp < 2.5 ? sq2 : sstp < 3.5 ? sq3 : sstp < 4.5 ? sq4 : sstp < 5.5 ? sq5 : sstp < 6.5 ? sq6 : sstp < 7.5 ? sq7 : sstp < 8.5 ? sq8 : sstp < 9.5 ? sq9 : sstp < 10.5 ? sq10 : sstp < 11.5 ? sq11 : sstp < 12.5 ? sq12 : sstp < 13.5 ? sq13 : sstp < 14.5 ? sq14 : sq15;
s6 = max(sval, 0);
g6 = (sval >= 0 && fract(spos) < 0.5 && running) ? 1 : 0;
// gates: LFO / RANDOM positive half, ENV above 0.25, CLOCK and SEQ their pulses
g1 = s1 > 0;
g2 = s2 > 0;
g3 = s3 > 0;
g4 = s4 > 0.25;
// ---- destinations, read like the module's CV inputs (once per block, CvReader low-pass)
has_t = time_cv > 0.5 || dst_time > 0.5;
has_s = size_cv > 0.5 || dst_size > 0.5;
has_h = shape_cv > 0.5 || dst_shape > 0.5;
has_p = pitch_cv > 0.5 || dst_pitch > 0.5;
rt_ = dst_time > 0.5 ? pick(dst_time, s1, s2, s3, s4, s5, s6, in3) : in3;
rs_ = dst_size > 0.5 ? pick(dst_size, s1, s2, s3, s4, s5, s6, in4) : in4;
rh_ = dst_shape > 0.5 ? pick(dst_shape, s1, s2, s3, s4, s5, s6, in5) : in5;
rp_ = dst_pitch > 0.5 ? pick(dst_pitch, s1, s2, s3, s4, s5, s6, in6 / 12) * 12 : in6;
rd_ = pick(dst_density, s1, s2, s3, s4, s5, s6, in10) * dn_amt;
ra1 = pick(dst_feedback, s1, s2, s3, s4, s5, s6, in11);
ra2 = pick(dst_drywet, s1, s2, s3, s4, s5, s6, in11);
ra3 = pick(dst_reverb, s1, s2, s3, s4, s5, s6, in11);
// CvChannel low-pass per block: TIME/SIZE/SHAPE 0.5, PITCH/DENSITY 1.0, ASSIGN 0.1 (first sample: direct)
k5 = init < 0.5 ? 1 : newblk ? 0.5 : 0;
k10 = init < 0.5 ? 1 : newblk ? 1 : 0;
// FLØCK: the assignable CV (feedback / dry-wet / reverb) is smoothed more than Beads (0.1 per block):
// 0.02 per block ≈ 12 ms, so a square / stepped source does not make the level click
k1 = init < 0.5 ? 1 : newblk ? 0.02 : 0;
cv_t = c_t + (rt_ - c_t) * k5;
cv_s = c_s + (rs_ - c_s) * k5;
cv_h = c_h + (rh_ - c_h) * k5;
cv_p = c_p + (rp_ - c_p) * k10;
cv_d = c_d + (rd_ - c_d) * k10;
cv_a1 = c_a1 + (ra1 - c_a1) * k1;
cv_a2 = c_a2 + (ra2 - c_a2) * k1;
cv_a3 = c_a3 + (ra3 - c_a3) * k1;
// FREEZE / SEED gate inputs (per sample, like the module's gate inputs)
frozen = freeze > 0.5 || (dst_freeze > 0.5 && pick(dst_freeze, g1, g2, g3, g4, s5, g6, in9) > 0.5);
ext = dst_seed > 0.5;
egate_now = ext && pick(dst_seed, g1, g2, g3, g4, s5, g6, in8) > 0.5;
// beads.cc: "Delay the seed input by 2.5ms" (event_delay.Read(size * 10)) — lets a CV
// sent together with the gate (e.g. SEQ → TIME and SEQ → SEED) settle first
poke(sdl, egate_now, sdw, 0);
egate = ext && peek(sdl, wrapi(sdw - BLK * 10, 1024), 0) > 0.5;
nsdw = wrapi(sdw + 1, 1024);

// ---- trigger generator (Processor::Process + TriggerGenerator::Render)
expo = clamp(20 * (abs(st_dens - 0.5) - 0.225), 0, 1);
lin_fm = (1 - expo) * cv_d;
exp_fm = expo * cv_d;
divmode = ext && seedstate > 1.5;
dens = clamp(st_dens + lin_fm + (divmode ? exp_fm : 0), 0, 1);
// FLØCK: no silent dead zone with AUTO GRAINS (latched, nothing in SEED): 12 o'clock = the slowest
// even grains (Beads: no grains at all there)
dens = (seedstate > 1.5 && !ext && dens >= 0.48 && dens <= 0.52) ? 0.479 : dens;
fmr = divmode ? 1 : pow(2, exp_fm * 60 / 12);
// gate stream: latched mode with an external SEED = the clock alone (divider), else button OR input
// the SEED input has its own edge memory (beads.cc previous_seed, updated whenever patched);
// the merged gate keeps TriggerGenerator::previous_flags_ (updated outside the divider)
erising = egate && prev_ext < 0.5;
sgate = divmode ? egate : (seedstate > 0.5 || egate);
rising = divmode ? erising : (sgate && prev_gate < 0.5);
npg = divmode ? prev_gate : sgate;
ph = tg_phase;
ratio = tg_ratio;
tapf = tg_freq;
tg_el = tg_elapsed;
trig = 0;
frac = 0;
regularity = 1;
maxf = 130.81278 / FS;
tgt = init < 0.5 ? 2 / FS : tg_target;
tapf = init < 0.5 ? 2 / FS : tapf;
ndiv = tg_div;
lpc = tg_lpc;
aud = tg_audio;
acc_p = tg_accept;
pcount = tg_count;
rint = init < 0.5 ? trunc(FS * 4) : tg_resetint;
quant = tg_quant;
if (divmode) {
	// ---- RenderDivider: clocked SEED (division CCW / probability CW of the incoming pulses)
	qv = dens * 2.15 * 8 - 0.5;
	qs = qv > quant ? -1 : 1;
	quant = dens < 0.48 ? clamp(trunc(qv + qs * 0.075 + 0.5), 0, 7) : quant;
	division = dens < 0.48 ? divratio(quant) : 1;
	psq = dens < 0.48 ? 1.01 : max((dens - 0.52) * 2.15, 0);
	prob = psq * psq;
	tapf = tapf + (tgt - tapf) * lpc;
	ph = ph + tapf;
	if (rising) {
		if (tg_el >= rint) {
			pcount = 0;
			ph = 0;
		}
		rint = max(trunc(FS * 4), 4 * tg_el);
		thr = trunc(FS / 48) + (aud > 0.5 ? 8 : 0);
		aud = (tg_el < thr) && (prob >= 1);
		acc_p = rnd() < prob && wrapi(pcount, division) < 0.5;
		if (acc_p) {
			period = tg_el;
			pfreq = 1 / period;
			tgt = prob >= 1 ? pfreq / division : pfreq * prob;
			if (aud) {
				noglide = division != ndiv;
				ndiv = division;
				noglide = noglide || tgt > (1.02 + 2 * pfreq) * tapf || tgt < (0.98 - 2 * pfreq) * tapf;
				lpc = noglide ? 1 : period / FS;
			} else {
				ph = 0;
				lpc = 1;
			}
		} else if (prob < 1) {
			tgt = tgt * (1 - prob);
		}
		pcount = wrapi(pcount + 1, 48);
		tg_el = 0;
	}
	tg_el = tg_el + 1;
	if (aud) {
		if (ph >= 1) {
			ph = ph - 1;
			frac = ph / tapf;
			trig = 1;
		}
	} else {
		ph = min(ph, 1);
		trig = acc_p && rising;
	}
	regularity = prob >= 1 ? 1 : 0;
} else if (dens < 0.48 || dens > 0.52) {
	randomize = dens > 0.52;
	f = (randomize ? 0.5 * maxf * pow(2, -(1 - dens) * 16) : maxf * pow(2, -dens * 16)) * fmr;
	if (!randomize) {
		ratio = 1;
	}
	ff = clamp(f * ratio, 0.000001, 0.25);
	ph = ph + (sgate ? ff : 0);
	reset = 0;
	if (rising) {
		ph = 0;
		reset = 1;
	} else if (ph >= 1) {
		ph = ph - 1;
		frac = ph / ff;
		reset = 1;
	}
	if (reset && randomize) {
		x = 0.1 + 0.9 * rnd();
		ratio = -1 / (-x * (1 + x * (0.5 + x * (0.3333 + x * 0.25))));
	}
	trig = reset && sgate;
	regularity = randomize ? 0 : 1;
} else if (seedstate < 1.5 || ext) {
	// manual taps: one grain per press
	ph = ph + tapf;
	if (rising) {
		ph = 0;
		tapf = 1 / tg_el;
		tg_el = 0;
	}
	tg_el = tg_el + 1;
	ph = min(ph, 1);
	trig = rising;
	regularity = 1 - (dens - 0.48) * 25;
}

// ---- feedback into the recording (GranularProcessor::ProcessInternal, 16-bit: brickwall)
inc_fb = newblk ? (clamp(st_fbk * 1.005 + (dst_feedback > 0.5 ? cv_a1 * fb_amt : 0), 0, 1) - s_fb) / BLK : i_fb;
fbk = s_fb + inc_fb;
slg = qi < 0.5 ? 0 : qi > 2.5 ? 1.75 : 1.3;
sl = slg > 0 ? inl + prev_l * fbk * (3 / slg) : inl + prev_l * fbk * fbk * 3;
sr = slg > 0 ? inr + prev_r * fbk * (3 / slg) : inr + prev_r * fbk * fbk * 3;
pk = min(max(abs(sl), abs(sr)), 40);
e1 = pk - lim_in_p;
li_p = lim_in_p + (e1 > 0 ? 0.1 : 1 / FS) * e1;
e2 = li_p - lim_in_lp;
li_lp = lim_in_lp + (e2 > 0 ? 0.5 : 1 / FS) * e2;
lg = li_lp <= 0.95 ? 1 : 0.95 / li_lp;
sl = sl * lg;
sr = sr * lg;
if (slg > 0) {
	sl = inl + fbk * (sclip(sl * slg) - inl);
	sr = inr + fbk * (sclip(sr * slg) - inr);
}

// ---- recording buffer with freeze tail (DelayLine::Write(in, frozen))
// FLØCK: a quality change keeps the recording (Beads clears it); only a head beyond the new length restarts
w = (qchg && wp >= MAXD) ? 0 : wp;
twp = tail_wp;
txf = tail_xf;
wfz = was_frozen;
nwr0 = qchg ? MAXD + 1 : min(nwr, MAXD + 1);   // after a change everything in the buffer counts as recorded
nwr1 = nwr0;
if (frozen) {
	if (wfz < 0.5) {
		twp = 0;
	}
	if (twp < 256) {
		poke(ftail, sl, twp, 0);
		poke(ftail, sr, twp, 1);
		twp = twp + 1;
	}
} else {
	if (wfz > 0.5 && twp > 0) {
		txf = twp;
	}
	if (twp > 0) {
		tpos = txf - twp;
		g = sstep(twp / txf);
		sl = sl + (peek(ftail, tpos, 0) - sl) * g;
		sr = sr + (peek(ftail, tpos, 1) - sr) * g;
		twp = twp - 1;
	}
	ql = qi < 0.5 ? q16(sl) : qi < 2.5 ? q12(sl) : mulaw(sl);
	qr = qi < 0.5 ? q16(sr) : qi < 2.5 ? q12(sr) : mulaw(sr);
	poke(buf, ql, w, 0);
	poke(buf, qr, w, 1);
	if (w < 4) {
		poke(buf, ql, w + MAXD, 0);
		poke(buf, qr, w + MAXD, 1);
	}
	w = w == 0 ? MAXD - 1 : w - 1;
	nwr1 = min(nwr0 + 1, MAXD + 1);
}

// ---- grain start (DelayGranularPlayer::Render + DelayGrain::Start)
gint = interval;
lpos = lastpos;
lspd = lastspd;
if (trig) {
	poke(sum, 1, 3, 0);
	for (k = 0; k < 32; k += 1) {
		if (peek(gr, k, 0) < 2.5 && peek(gr, k, 6) > 0) {
			poke(sum, peek(sum, 3, 0) + 1, 3, 0);
		}
	}
	nact = peek(sum, 3, 0);
	tamt = st_tamt;
	samt = st_samt;
	hamt = st_hamt;
	pamt = st_pamt;
	dur_k = rparam(st_size, samt, cv_s, has_s, 1, 1);
	rev = dur_k < 0.3333333;
	amp = 1 / sqrt(nact);
	spread = min(1, ramount(tamt, has_t) + ramount(samt, has_s) + ramount(hamt, has_h) + ramount(pamt, has_p) + 1 - regularity);
	u = rnd();
	v = rnd();
	pan = 0.5 + (u - 0.5) * min(0.5 * nact * spread * v, 1);
	maxdel = MAXD - 2 * 257;
	gdelay = rparam(st_timeh, tamt, cv_t, has_t, 1, 1) * maxdel + 257;
	semis = rparam(st_pitch + (kon > 0.5 ? knote : 0), pamt, cv_p, has_p, 24, 0);
	speed = (rev ? -1 : 1) * pow(2, semis / 12);
	csh = rev ? dur_k * 3 * (2 - dur_k * 3) : 1 - 1.5 * (dur_k - 0.3333333);
	duration = pow(2, min(1, 1.025 * csh) * -9) * FS * 4;
	shp = rparam(st_shape, hamt, cv_h, has_h, 1, 1);
	g0 = peek(prio, 0, 0);
	cons = speed - (frozen ? 0 : 1);
	gdelay = gdelay - frac * cons;
	if (cons != 0) {
		duration = min(duration, MAXD / abs(cons));
	}
	if (cons > 0) {
		gdelay = max(gdelay, duration * cons);
	} else if (cons < 0) {
		gdelay = min(gdelay, MAXD + duration * cons);
	}
	if (pan < 0.5) {
		pn = pan * 2;
		poke(gr, amp, g0, 10);
		poke(gr, (1 - pn) * (1 + pn) * amp, g0, 11);
		poke(gr, 0, g0, 12);
		poke(gr, pn * (2 - pn) * amp, g0, 13);
	} else {
		pn = (1 - pan) * 2;
		poke(gr, pn * (2 - pn) * amp, g0, 10);
		poke(gr, 0, g0, 11);
		poke(gr, (1 - pn) * (1 + pn) * amp, g0, 12);
		poke(gr, amp, g0, 13);
	}
	// DelayGrain stores position and speed in fixed point (×1024, truncated) like the module
	poke(gr, trunc(gdelay * 1024) / 1024, g0, 8);
	lpos = gdelay / MAXD;
	lspd = speed;
	poke(gr, trunc(speed * 1024) / 1024, g0, 9);
	// GrainEnvelope::Start(duration, shape, fractional)
	sus = max(1 - 3 * shp, 0);
	at = (shp - 0.33333333) * 1.5;
	if (at < 0) {
		at = 0;
	} else if (at < 0.5) {
		at = at * at * at * 4;
	}
	re = (1 - at) * (1 - sus);
	ia = 1 / max(duration * at, 0.0005 * FS * (1 + 3 * sus));
	is = 1 / max(duration * sus, 2);
	ir = 1 / max(duration * re, 0.010 * FS);
	poke(gr, ia, g0, 2);
	poke(gr, is, g0, 3);
	poke(gr, ir, g0, 4);
	poke(gr, at < 0.5 ? 2 * at : 2 - 2 * at, g0, 5);
	gph = ia * frac;
	gst = 0;
	if (gph >= 1) {
		gph = (gph - 1) / ia * is;
		gst = 1;
	}
	poke(gr, gst, g0, 0);
	poke(gr, gph, g0, 1);
	poke(gr, trunc(duration), g0, 14);
	poke(gr, 1, g0, 6);
	poke(gr, 0, g0, 7);
	// SortGrainList (polyphonic)
	inst = trunc(FS * 0.005);
	pre = trunc(FS * 0.1);
	f0 = 1;
	f1 = 1;
	f2 = 1;
	f3 = 1;
	if (gint < trunc(FS * 0.025)) {
		first = peek(prio, 0, 0);
		for (k = 0; k < 31; k += 1) {
			poke(prio, peek(prio, k + 1, 0), k, 0);
		}
		poke(prio, first, 31, 0);
		f0 = gint + 1;
		f1 = inst;
		f2 = inst;
		f3 = pre;
		if (gint > inst) {
			tmp = f0;
			f0 = f2;
			f2 = tmp;
		}
	} else {
		for (k = 0; k < 4; k += 1) {
			poke(sum, k, 4, 0);
			poke(sum, peek(gr, peek(prio, k, 0), 14), 5, 0);
			for (j = k + 1; j < 32; j += 1) {
				rj = peek(gr, peek(prio, j, 0), 14);
				if (rj < peek(sum, 5, 0)) {
					poke(sum, j, 4, 0);
					poke(sum, rj, 5, 0);
				}
			}
			best = peek(sum, 4, 0);
			if (best != k) {
				tmp = peek(prio, k, 0);
				poke(prio, peek(prio, best, 0), k, 0);
				poke(prio, tmp, best, 0);
			}
		}
		f0 = inst;
		f1 = inst;
		f2 = gint;
		f3 = pre;
		if (gint > pre) {
			tmp = f2;
			f2 = f3;
			f3 = tmp;
		}
	}
	for (k = 0; k < 4; k += 1) {
		gk = peek(prio, k, 0);
		fd = k == 0 ? f0 : k == 1 ? f1 : k == 2 ? f2 : f3;
		fd = max(fd, 1);
		if (peek(gr, gk, 14) > fd) {
			poke(gr, 1 / fd, gk, 7);
			poke(gr, trunc(peek(gr, gk, 6) * fd), gk, 14);
		}
	}
	gint = 0;
}

// ---- render all grains (DelayGrain::Render<STOP, fade_out>)
poke(sum, 0, 0, 0);
poke(sum, 0, 1, 0);
poke(sum, 0, 2, 0);
for (k = 0; k < 32; k += 1) {
	stg = peek(gr, k, 0);
	vs = peek(gr, k, 6);
	if (stg < 2.5 && vs > 0) {
		poke(sum, peek(sum, 2, 0) + 1, 2, 0);
		dl = peek(gr, k, 8) - peek(gr, k, 9);
		if (!frozen) {
			dl = dl + 1;
		}
		if (dl < 0 || dl >= MAXD) {
			dl = 0;
			stg = 3;
		}
		dd = abs(dl >= MAXD * 0.5 ? dl - MAXD : dl);
		fr = dd < 256 ? dd / 256 : 1;
		di = floor(dl);
		df = dl - di;
		idx = wrapi(w + di + MAXD - 1, MAXD);
		xl0 = bvalid(idx, nwr1, MAXD) > 0.5 ? peek(buf, idx, 0) : 0;
		xl1 = bvalid(idx + 1, nwr1, MAXD) > 0.5 ? peek(buf, idx + 1, 0) : 0;
		xl2 = bvalid(idx + 2, nwr1, MAXD) > 0.5 ? peek(buf, idx + 2, 0) : 0;
		xl3 = bvalid(idx + 3, nwr1, MAXD) > 0.5 ? peek(buf, idx + 3, 0) : 0;
		xr0 = bvalid(idx, nwr1, MAXD) > 0.5 ? peek(buf, idx, 1) : 0;
		xr1 = bvalid(idx + 1, nwr1, MAXD) > 0.5 ? peek(buf, idx + 1, 1) : 0;
		xr2 = bvalid(idx + 2, nwr1, MAXD) > 0.5 ? peek(buf, idx + 2, 1) : 0;
		xr3 = bvalid(idx + 3, nwr1, MAXD) > 0.5 ? peek(buf, idx + 3, 1) : 0;
		cl = (xl2 - xl0) * 0.5;
		vl = xl1 - xl2;
		wl = cl + vl;
		al = wl + vl + (xl3 - xl1) * 0.5;
		yl = (((al * df) - (wl + al)) * df + cl) * df + xl1;
		cr = (xr2 - xr0) * 0.5;
		vr = xr1 - xr2;
		wr = cr + vr;
		ar = wr + vr + (xr3 - xr1) * 0.5;
		yr = (((ar * df) - (wr + ar)) * df + cr) * df + xr1;
		ffr = sstep(fr);
		// GrainEnvelope::Render
		env = 0;
		gph = peek(gr, k, 1);
		if (stg < 2.5) {
			if (stg > 0.5 && stg < 1.5) {
				env = 1;
			} else {
				tt = stg < 0.5 ? gph : 1 - gph;
				bs = stg < 0.5 ? tt : tt * tt * tt * tt;
				env = bs + (sstep(tt) - bs) * peek(gr, k, 5);
			}
			inc = peek(gr, k, 2 + stg);
			gph = gph + inc;
			if (gph >= 1) {
				t2 = (gph - 1) / inc;
				stg = stg + 1;
				gph = stg < 2.5 ? t2 * peek(gr, k, 2 + stg) : 0;
			}
		}
		vs = vs - peek(gr, k, 7);
		genv = env * max(vs, 0) * ffr;
		poke(sum, peek(sum, 0, 0) + (yl * peek(gr, k, 10) + yr * peek(gr, k, 11)) * genv, 0, 0);
		poke(sum, peek(sum, 1, 0) + (yl * peek(gr, k, 12) + yr * peek(gr, k, 13)) * genv, 1, 0);
		rem = peek(gr, k, 14) - 1;
		if (stg > 2.5 || vs <= 0) {
			rem = 0;
		}
		poke(gr, stg, k, 0);
		poke(gr, gph, k, 1);
		poke(gr, vs, k, 6);
		poke(gr, dl, k, 8);
		poke(gr, rem, k, 14);
	}
}
gint = gint + 1;
outl = peek(sum, 0, 0);
outr = peek(sum, 1, 0);
nplay = peek(sum, 2, 0);

// ---- feedback path: DC blocker (Svf HP 40 Hz, q 0.5) → one-pole 0.999
fhp = 40 / FS;
gg = fhp * (pi + fhp * fhp * (0.326 * pi * pi * pi + 0.1823 * pi * pi * pi * pi * pi * fhp * fhp));
hh = 1 / (1 + 2 * gg + gg * gg);
hpl = (outl - 2 * hp1 - gg * hp1 - hp2) * hh;
bpl = gg * hpl + hp1;
n_hp1 = gg * hpl + bpl;
lpl = gg * bpl + hp2;
n_hp2 = gg * bpl + lpl;
hpr = (outr - 2 * hq1 - gg * hq1 - hq2) * hh;
bpr = gg * hpr + hq1;
n_hq1 = gg * hpr + bpr;
lpr = gg * bpr + hq2;
n_hq2 = gg * bpr + lpr;
fblp = qi < 0.5 ? 0.999 : qi < 2.5 ? 0.9 : 0.75;
n_prev_l = prev_l + fblp * (hpl - prev_l);
n_prev_r = prev_r + fblp * (hpr - prev_r);

// ---- dry / wet (Processor::Process)
dw = clamp(st_dwk * 1.005 + (dst_drywet > 0.5 ? cv_a2 * dw_amt : 0), 0, 1);
dry_t = (1 - dw) * (1 + dw) * 0.75;
wet_t = dw * (2 - dw) * 1.5;
inc_dry = newblk ? (dry_t - s_dry) / BLK : i_dry;
inc_wet = newblk ? (wet_t - s_wet) / BLK : i_wet;
dry = s_dry + inc_dry;
wet = s_wet + inc_wet;
dryl = qi > 0.5 && qi < 1.5 ? trunc(inl * 4096) / 4096 : qi > 2.5 ? mulaw(inl) : inl;
dryr = qi > 0.5 && qi < 1.5 ? trunc(inr * 4096) / 4096 : qi > 2.5 ? mulaw(inr) : inr;
ml = dry * dryl + wet * outl;
mr = dry * dryr + wet * outr;

// ---- wow & flutter (Scorched cassette): WowAndFlutter (24 kHz) converted to the host rate
wrph = wf_rph;
wrf = init < 0.5 ? 0.125 / FS : wf_rf;
wwph = wf_wph;
wfph = wf_fph;
wdel = wf_del;
winc = wf_inc;
wpend = wf_pend;
wlpl = wf_lpl;
wlpr = wf_lpr;
wwp = wf_w;
if (qi > 2.5) {
	if (newblk) {
		pph = wrph;
		wrph = wrph + wrf * BLK;
		wrph = wrph >= 1 ? wrph - 1 : wrph;
		wrm = 0.5 + 0.5 * lsin(wrph);
		wpend = wrph >= 0.25 && pph < 0.25;
		wfm = 0.5 + 1.5 * wrm * wrm;
		wam = 1 - 0.4 * wrm;
		wwph = wwph + (1 / FS) * 0.23 * BLK * wfm;
		wwph = wwph >= 1 ? wwph - 1 : wwph;
		wfph = wfph + (1 / FS) * 1.99 * BLK;
		wfph = wfph >= 1 ? wfph - 1 : wfph;
		wdt = (1 + (105 * (0.5 + 0.5 * lsin(wwph)) + 17 * (0.5 + 0.5 * lsin(wfph))) * wam) * FS / 24000;
		winc = (wdt - wdel) / BLK;
	}
	wdel = wdel + winc;
	poke(wfl, ml, wwp, 0);
	poke(wfl, mr, wwp, 1);
	wwp = wrapi(wwp - 1, 1024);
	wdi = trunc(wdel);
	wdf = wdel - wdi;
	wlc = 1 - pow(0.05, 24000 / FS);
	wa = peek(wfl, wrapi(wwp + wdi, 1024), 0);
	wlpl = wlpl + wlc * (wa + (peek(wfl, wrapi(wwp + wdi + 1, 1024), 0) - wa) * wdf - wlpl);
	wa = peek(wfl, wrapi(wwp + wdi, 1024), 1);
	wlpr = wlpr + wlc * (wa + (peek(wfl, wrapi(wwp + wdi + 1, 1024), 1) - wa) * wdf - wlpr);
	ml = wlpl;
	mr = wlpr;
	if (blk > BLK - 1.5 && wpend) {
		wrf = (1 / 24000) * (0.05 + rnd() * 0.2) * 24000 / FS;
		wpend = 0;
	}
}

// ---- pre-reverb limiter (decay 1/(4 sr), 0.9)
pk = min(max(abs(ml), abs(mr)), 40);
e1 = pk - lim_pre_p;
lp_p = lim_pre_p + (e1 > 0 ? 0.1 : 1 / (FS * 4)) * e1;
e2 = lp_p - lim_pre_lp;
lp_lp = lim_pre_lp + (e2 > 0 ? 0.5 : 1 / (FS * 4)) * e2;
lg = lp_lp <= 0.9 ? 1 : 0.9 / lp_lp;
ml = ml * lg;
mr = mr * lg;

// ---- reverb (Griesinger / Dattorro topology, FxEngine 16-bit, 32768 words)
rva = clamp(st_rvk * 1.005 + (dst_reverb > 0.5 ? cv_a3 * rv_amt : 0), 0, 1);
rmix = rva * rva * 0.9;
rtime = qi > 0.5 ? 0.45 + 0.5 * rva * rva * rva : 0.3 + 0.6 * rva * rva * rva;
rlp = qi > 0.5 ? 0.4 : 0.6;
ig = 0.2 * (1 - 0.333 * rtime);
ssq = rmix * (2 - rmix);
inc_rd = newblk ? ((1 - rmix) * (1 + rmix) - rv_dry) / BLK : i_rd;
inc_rw = newblk ? (0.4 / ig - rv_wet) / BLK : i_rw;
inc_rs = newblk ? (ssq * (2 - ssq) * ig - rv_send) / BLK : i_rs;
r_dry = rv_dry + inc_rd;
r_wet = rv_wet + inc_rw;
r_send = rv_send + inc_rs;
rw = rv_wp - 1;
if (rw < 0) {
	rw = rw + 32768;
}
// stmlib CosineOscillator (approximate), 0.5 Hz / 0.3 Hz × 32, updated every 32 samples.
// Start(): y1 = c·0.25, y0 = 0.5 → value() = y1 + 0.5 until the first update.
c1 = 16 * (0.25 - 0.5 / FS * 32) * (1 - 2 * (0.25 - 0.5 / FS * 32));
c2 = 16 * (0.25 - 0.3 / FS * 32) * (1 - 2 * (0.25 - 0.3 / FS * 32));
y10 = init < 0.5 ? 0.5 : l1y0;
y11 = init < 0.5 ? c1 * 0.25 : l1y1;
y20 = init < 0.5 ? 0.5 : l2y0;
y21 = init < 0.5 ? c2 * 0.25 : l2y1;
lv1 = init < 0.5 ? c1 * 0.25 + 0.5 : l1v;
lv2 = init < 0.5 ? c2 * 0.25 + 0.5 : l2v;
if (wrapi(rw, 32) < 0.5) {
	tmp = y10;
	y10 = c1 * y10 - y11;
	y11 = tmp;
	lv1 = tmp + 0.5;
	tmp = y20;
	y20 = c2 * y20 - y21;
	y21 = tmp;
	lv2 = tmp + 0.5;
}
kap = 0.625;
// smear AP1: interpolate at 10 + 80*lfo1, write at 100
o = 10 + 80 * lv1;
oi = floor(o);
of = o - oi;
ra = peek(rv, wrapi(rw + oi, 32768), 0);
rb = peek(rv, wrapi(rw + oi + 1, 32768), 0);
acc = ra + (rb - ra) * of;
poke(rv, q16(acc), wrapi(rw + 100, 32768), 0);
acc = (ml + mr) * r_send;
// 4 diffusers: base/length 0/150, 151/214, 366/319, 686/527
pr = peek(rv, wrapi(rw + 149, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 151 + 213, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 151, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 366 + 318, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 366, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 686 + 526, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 686, 32768), 0);
acc = acc * -kap + pr;
apout = acc;
// left loop: del2 (15314/6312) → lp → dap1a (1214/2182) → dap1b (3397/2690) → del1 (6088/4501)
o = 6261 + 50 * lv2;
oi = floor(o);
of = o - oi;
ra = peek(rv, wrapi(rw + oi + 15314, 32768), 0);
rb = peek(rv, wrapi(rw + oi + 15315, 32768), 0);
acc = apout + (ra + (rb - ra) * of) * rtime;
lp1 = rv_lp1 + rlp * (acc - rv_lp1);
acc = lp1;
pr = peek(rv, wrapi(rw + 1214 + 2181, 32768), 0);
acc = acc + pr * -kap;
poke(rv, q16(acc), wrapi(rw + 1214, 32768), 0);
acc = acc * kap + pr;
pr = peek(rv, wrapi(rw + 3397 + 2689, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 3397, 32768), 0);
acc = acc * -kap + pr;
poke(rv, q16(acc), wrapi(rw + 6088, 32768), 0);
wl_ = acc;
// right loop: del1 → lp → dap2a (10590/2525) → dap2b (13116/2197) → del2
o = 4460 + 40 * lv1;
oi = floor(o);
of = o - oi;
ra = peek(rv, wrapi(rw + oi + 6088, 32768), 0);
rb = peek(rv, wrapi(rw + oi + 6089, 32768), 0);
acc = apout + (ra + (rb - ra) * of) * rtime;
lp2 = rv_lp2 + rlp * (acc - rv_lp2);
acc = lp2;
pr = peek(rv, wrapi(rw + 10590 + 2524, 32768), 0);
acc = acc + pr * kap;
poke(rv, q16(acc), wrapi(rw + 10590, 32768), 0);
acc = acc * -kap + pr;
pr = peek(rv, wrapi(rw + 13116 + 2196, 32768), 0);
acc = acc + pr * -kap;
poke(rv, q16(acc), wrapi(rw + 13116, 32768), 0);
acc = acc * kap + pr;
poke(rv, q16(acc), wrapi(rw + 15314, 32768), 0);
wr_ = acc;
ml = ml * r_dry + wl_ * r_wet;
mr = mr * r_dry + wr_ * r_wet;

// ---- output limiter (decay 1/(6 sr), 0.9) and output gain
pk = min(max(abs(ml), abs(mr)), 40);
e1 = pk - lim_out_p;
lo_p = lim_out_p + (e1 > 0 ? 0.1 : 1 / (FS * 6)) * e1;
e2 = lo_p - lim_out_lp;
lo_lp = lim_out_lp + (e2 > 0 ? 0.5 : 1 / (FS * 6)) * e2;
lg = lo_lp <= 0.9 ? 1 : 0.9 / lo_lp;
ocomp = agc > 0.5 ? 1 / ggain : 1;
// FLØCK safety: soft knee above 0.9 (never a hard digital clip, whatever a random patch does)
out1 = sknee(ml * lg * outgain * ocomp);
out2 = sknee(mr * lg * outgain * ocomp);
out3 = trig;
out4 = nplay;
out5 = w / MAXD;
out6 = lpos;
out7 = lspd;
out8 = sstp;
out9 = running;
out10 = ggain;
out11 = learning;

// ---- state write-back (all History writes at the end of the pass)
init = 1;
wp = w;
s_time = st_time;
s_size = st_size;
s_shape = st_shape;
s_pitch = st_pitch;
s_tamt = st_tamt;
s_samt = st_samt;
s_hamt = st_hamt;
s_pamt = st_pamt;
s_dens = st_dens;
s_timeh = st_timeh;
s_fbk = st_fbk;
s_dwk = st_dwk;
s_rvk = st_rvk;
s_fb = fbk;
s_dry = dry;
s_wet = wet;
tg_phase = ph;
tg_ratio = ratio;
tg_freq = tapf;
tg_elapsed = tg_el;
prev_gate = npg;
prev_ext = egate;
g_peak = npeak;
g_agc = gagc;
g_stable = gstb;
g_gain = ggain;
g_inc = ginc;
g_time = gtime;
g_rst = agc_restart;
sdw = nsdw;
interval = gint;
lastpos = lpos;
lastspd = lspd;
prev_l = n_prev_l;
prev_r = n_prev_r;
hp1 = n_hp1;
hp2 = n_hp2;
hq1 = n_hq1;
hq2 = n_hq2;
lim_in_p = li_p;
lim_in_lp = li_lp;
lim_pre_p = lp_p;
lim_pre_lp = lp_lp;
lim_out_p = lo_p;
lim_out_lp = lo_lp;
was_frozen = frozen;
tail_wp = twp;
tail_xf = txf;
rv_wp = rw;
rv_lp1 = lp1;
rv_lp2 = lp2;
rv_dry = r_dry;
rv_wet = r_wet;
rv_send = r_send;
blk = nblk;
i_fb = inc_fb;
i_dry = inc_dry;
i_wet = inc_wet;
i_rd = inc_rd;
i_rw = inc_rw;
i_rs = inc_rs;
l1y0 = y10;
l1y1 = y11;
l2y0 = y20;
l2y1 = y21;
l1v = lv1;
prev_bp = bp;
bar_cnt = nbars;
was_run = running;
l1_ph = l1f;
l2_ph = l2f;
rn_ph = rnf;
rn_pph = rnf;
rn_seed = nseed;
rn_from = nfrom;
rn_to = nto;
env_st = nenv;
ck_ph = ckf;
c_t = cv_t;
c_s = cv_s;
c_h = cv_h;
c_p = cv_p;
c_d = cv_d;
c_a1 = cv_a1;
c_a2 = cv_a2;
c_a3 = cv_a3;
tg_target = tgt;
tg_lpc = lpc;
tg_audio = aud;
tg_accept = acc_p;
tg_count = pcount;
tg_resetint = rint;
tg_quant = quant;
tg_div = ndiv;
l2v = lv2;
out12 = min(nwr1, MAXD) / MAXD;   // how much of the buffer holds a recording (tape display)
out13 = -1;
wf_rph = wrph;
wf_rf = wrf;
wf_wph = wwph;
wf_fph = wfph;
wf_del = wdel;
wf_inc = winc;
wf_lpl = wlpl;
wf_lpr = wlpr;
wf_w = wwp;
wf_pend = wpend;
s_sca = sca;
i_sca = isca;
bl1 = nbl1;
bl2 = nbl2;
br1 = nbr1;
br2 = nbr2;
qc = qi;
nwr = nwr1;
