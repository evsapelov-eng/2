// ===== per-hit modulation (generated): knob smoothed per sample + offset latched at the hit =====
// sources: velocity 0 at full .. -1 at the softest; note (C1 = 0, C3 = +1, C-1 = -1);
// random -0.5 .. 0.5 = hsh(hit number, knob index) - 0.5 (the panel computes the same numbers)
trig = init > 0.5 && ktrig != lastk;
vsrc = kvel - 1;
ksrc = clamp((knote - 36) / 24, -1, 1);
sk = init > 0.5 ? 0.002 : 1;
sm_amp_len = s_amp_len + (amp_len - s_amp_len) * sk;
q_amp_len = trig ? (v_amp_len * vel_amt * vsrc + k_amp_len * note_amt * ksrc + r_amp_len * rnd_amt * (hsh(ktrig, 0) - 0.5)) : o_amp_len;
e_amp_len = clamp(sm_amp_len + q_amp_len, 0, 1);
sm_amp_att = s_amp_att + (amp_att - s_amp_att) * sk;
q_amp_att = trig ? (v_amp_att * vel_amt * vsrc + k_amp_att * note_amt * ksrc + r_amp_att * rnd_amt * (hsh(ktrig, 1) - 0.5)) : o_amp_att;
e_amp_att = clamp(sm_amp_att + q_amp_att, 0, 1);
sm_amp_crv = s_amp_crv + (amp_crv - s_amp_crv) * sk;
q_amp_crv = trig ? (v_amp_crv * vel_amt * vsrc + k_amp_crv * note_amt * ksrc + r_amp_crv * rnd_amt * (hsh(ktrig, 2) - 0.5)) : o_amp_crv;
e_amp_crv = clamp(sm_amp_crv + q_amp_crv, 0, 1);
sm_pit_swp = s_pit_swp + (pit_swp - s_pit_swp) * sk;
q_pit_swp = trig ? (v_pit_swp * vel_amt * vsrc + k_pit_swp * note_amt * ksrc + r_pit_swp * rnd_amt * (hsh(ktrig, 3) - 0.5)) : o_pit_swp;
e_pit_swp = clamp(sm_pit_swp + q_pit_swp, 0, 1);
sm_pit_time = s_pit_time + (pit_time - s_pit_time) * sk;
q_pit_time = trig ? (v_pit_time * vel_amt * vsrc + k_pit_time * note_amt * ksrc + r_pit_time * rnd_amt * (hsh(ktrig, 4) - 0.5)) : o_pit_time;
e_pit_time = clamp(sm_pit_time + q_pit_time, 0, 1);
sm_pit_crv = s_pit_crv + (pit_crv - s_pit_crv) * sk;
q_pit_crv = trig ? (v_pit_crv * vel_amt * vsrc + k_pit_crv * note_amt * ksrc + r_pit_crv * rnd_amt * (hsh(ktrig, 5) - 0.5)) : o_pit_crv;
e_pit_crv = clamp(sm_pit_crv + q_pit_crv, 0, 1);
sm_clk_amt = s_clk_amt + (clk_amt - s_clk_amt) * sk;
q_clk_amt = trig ? (v_clk_amt * vel_amt * vsrc + k_clk_amt * note_amt * ksrc + r_clk_amt * rnd_amt * (hsh(ktrig, 6) - 0.5)) : o_clk_amt;
e_clk_amt = clamp(sm_clk_amt + q_clk_amt, 0, 1);
sm_clk_tone = s_clk_tone + (clk_tone - s_clk_tone) * sk;
q_clk_tone = trig ? (v_clk_tone * vel_amt * vsrc + k_clk_tone * note_amt * ksrc + r_clk_tone * rnd_amt * (hsh(ktrig, 7) - 0.5)) : o_clk_tone;
e_clk_tone = clamp(sm_clk_tone + q_clk_tone, 0, 1);
sm_nz_amt = s_nz_amt + (nz_amt - s_nz_amt) * sk;
q_nz_amt = trig ? (v_nz_amt * vel_amt * vsrc + k_nz_amt * note_amt * ksrc + r_nz_amt * rnd_amt * (hsh(ktrig, 8) - 0.5)) : o_nz_amt;
e_nz_amt = clamp(sm_nz_amt + q_nz_amt, 0, 1);
sm_nz_col = s_nz_col + (nz_col - s_nz_col) * sk;
q_nz_col = trig ? (v_nz_col * vel_amt * vsrc + k_nz_col * note_amt * ksrc + r_nz_col * rnd_amt * (hsh(ktrig, 9) - 0.5)) : o_nz_col;
e_nz_col = clamp(sm_nz_col + q_nz_col, 0, 1);
sm_nz_dec = s_nz_dec + (nz_dec - s_nz_dec) * sk;
q_nz_dec = trig ? (v_nz_dec * vel_amt * vsrc + k_nz_dec * note_amt * ksrc + r_nz_dec * rnd_amt * (hsh(ktrig, 10) - 0.5)) : o_nz_dec;
e_nz_dec = clamp(sm_nz_dec + q_nz_dec, 0, 1);
sm_hm_amt = s_hm_amt + (hm_amt - s_hm_amt) * sk;
q_hm_amt = trig ? (v_hm_amt * vel_amt * vsrc + k_hm_amt * note_amt * ksrc + r_hm_amt * rnd_amt * (hsh(ktrig, 11) - 0.5)) : o_hm_amt;
e_hm_amt = clamp(sm_hm_amt + q_hm_amt, 0, 1);
sm_hm_spr = s_hm_spr + (hm_spr - s_hm_spr) * sk;
q_hm_spr = trig ? (v_hm_spr * vel_amt * vsrc + k_hm_spr * note_amt * ksrc + r_hm_spr * rnd_amt * (hsh(ktrig, 12) - 0.5)) : o_hm_spr;
e_hm_spr = clamp(sm_hm_spr + q_hm_spr, 0, 1);
sm_dr_amt = s_dr_amt + (dr_amt - s_dr_amt) * sk;
q_dr_amt = trig ? (v_dr_amt * vel_amt * vsrc + k_dr_amt * note_amt * ksrc + r_dr_amt * rnd_amt * (hsh(ktrig, 13) - 0.5)) : o_dr_amt;
e_dr_amt = clamp(sm_dr_amt + q_dr_amt, 0, 1);
sm_dr_knee = s_dr_knee + (dr_knee - s_dr_knee) * sk;
q_dr_knee = trig ? (v_dr_knee * vel_amt * vsrc + k_dr_knee * note_amt * ksrc + r_dr_knee * rnd_amt * (hsh(ktrig, 14) - 0.5)) : o_dr_knee;
e_dr_knee = clamp(sm_dr_knee + q_dr_knee, 0, 1);
sm_fm_amt = s_fm_amt + (fm_amt - s_fm_amt) * sk;
q_fm_amt = trig ? (v_fm_amt * vel_amt * vsrc + k_fm_amt * note_amt * ksrc + r_fm_amt * rnd_amt * (hsh(ktrig, 15) - 0.5)) : o_fm_amt;
e_fm_amt = clamp(sm_fm_amt + q_fm_amt, 0, 1);
sm_fm_rat = s_fm_rat + (fm_rat - s_fm_rat) * sk;
q_fm_rat = trig ? (v_fm_rat * vel_amt * vsrc + k_fm_rat * note_amt * ksrc + r_fm_rat * rnd_amt * (hsh(ktrig, 16) - 0.5)) : o_fm_rat;
e_fm_rat = clamp(sm_fm_rat + q_fm_rat, 0, 1);
sm_fm_dec = s_fm_dec + (fm_dec - s_fm_dec) * sk;
q_fm_dec = trig ? (v_fm_dec * vel_amt * vsrc + k_fm_dec * note_amt * ksrc + r_fm_dec * rnd_amt * (hsh(ktrig, 17) - 0.5)) : o_fm_dec;
e_fm_dec = clamp(sm_fm_dec + q_fm_dec, 0, 1);
sm_wd_amt = s_wd_amt + (wd_amt - s_wd_amt) * sk;
q_wd_amt = trig ? (v_wd_amt * vel_amt * vsrc + k_wd_amt * note_amt * ksrc + r_wd_amt * rnd_amt * (hsh(ktrig, 18) - 0.5)) : o_wd_amt;
e_wd_amt = clamp(sm_wd_amt + q_wd_amt, 0, 1);
sm_sp_amt = s_sp_amt + (sp_amt - s_sp_amt) * sk;
q_sp_amt = trig ? (v_sp_amt * vel_amt * vsrc + k_sp_amt * note_amt * ksrc + r_sp_amt * rnd_amt * (hsh(ktrig, 19) - 0.5)) : o_sp_amt;
e_sp_amt = clamp(sm_sp_amt + q_sp_amt, 0, 1);
sm_sp_time = s_sp_time + (sp_time - s_sp_time) * sk;
q_sp_time = trig ? (v_sp_time * vel_amt * vsrc + k_sp_time * note_amt * ksrc + r_sp_time * rnd_amt * (hsh(ktrig, 20) - 0.5)) : o_sp_time;
e_sp_time = clamp(sm_sp_time + q_sp_time, 0, 1);
sm_level = s_level + (level - s_level) * sk;
q_level = trig ? (v_level * vel_amt * vsrc + k_level * note_amt * ksrc + r_level * rnd_amt * (hsh(ktrig, 21) - 0.5)) : o_level;
e_level = clamp(sm_level + q_level, 0, 1);
sm_tune = s_tune + (tune - s_tune) * sk;
q_tune = trig ? (v_tune * vel_amt * vsrc + k_tune * note_amt * ksrc + r_tune * rnd_amt * (hsh(ktrig, 22) - 0.5)) : o_tune;
e_tune = clamp(sm_tune + q_tune, 0, 1);
sm_amp_phs = s_amp_phs + (amp_phs - s_amp_phs) * sk;
q_amp_phs = trig ? (v_amp_phs * vel_amt * vsrc + k_amp_phs * note_amt * ksrc + r_amp_phs * rnd_amt * (hsh(ktrig, 23) - 0.5)) : o_amp_phs;
e_amp_phs = clamp(sm_amp_phs + q_amp_phs, 0, 1);
sm_sub_lvl = s_sub_lvl + (sub_lvl - s_sub_lvl) * sk;
q_sub_lvl = trig ? (v_sub_lvl * vel_amt * vsrc + k_sub_lvl * note_amt * ksrc + r_sub_lvl * rnd_amt * (hsh(ktrig, 24) - 0.5)) : o_sub_lvl;
e_sub_lvl = clamp(sm_sub_lvl + q_sub_lvl, 0, 1);
sm_sub_len = s_sub_len + (sub_len - s_sub_len) * sk;
q_sub_len = trig ? (v_sub_len * vel_amt * vsrc + k_sub_len * note_amt * ksrc + r_sub_len * rnd_amt * (hsh(ktrig, 25) - 0.5)) : o_sub_len;
e_sub_len = clamp(sm_sub_len + q_sub_len, 0, 1);
sm_sub_crv = s_sub_crv + (sub_crv - s_sub_crv) * sk;
q_sub_crv = trig ? (v_sub_crv * vel_amt * vsrc + k_sub_crv * note_amt * ksrc + r_sub_crv * rnd_amt * (hsh(ktrig, 26) - 0.5)) : o_sub_crv;
e_sub_crv = clamp(sm_sub_crv + q_sub_crv, 0, 1);
sm_clk_bw = s_clk_bw + (clk_bw - s_clk_bw) * sk;
q_clk_bw = trig ? (v_clk_bw * vel_amt * vsrc + k_clk_bw * note_amt * ksrc + r_clk_bw * rnd_amt * (hsh(ktrig, 27) - 0.5)) : o_clk_bw;
e_clk_bw = clamp(sm_clk_bw + q_clk_bw, 0, 1);
sm_dr_asym = s_dr_asym + (dr_asym - s_dr_asym) * sk;
q_dr_asym = trig ? (v_dr_asym * vel_amt * vsrc + k_dr_asym * note_amt * ksrc + r_dr_asym * rnd_amt * (hsh(ktrig, 28) - 0.5)) : o_dr_asym;
e_dr_asym = clamp(sm_dr_asym + q_dr_asym, 0, 1);
sm_glue = s_glue + (glue - s_glue) * sk;
q_glue = trig ? (v_glue * vel_amt * vsrc + k_glue * note_amt * ksrc + r_glue * rnd_amt * (hsh(ktrig, 29) - 0.5)) : o_glue;
e_glue = clamp(sm_glue + q_glue, 0, 1);
sm_nz_lfo = s_nz_lfo + (nz_lfo - s_nz_lfo) * sk;
q_nz_lfo = trig ? (v_nz_lfo * vel_amt * vsrc + k_nz_lfo * note_amt * ksrc + r_nz_lfo * rnd_amt * (hsh(ktrig, 30) - 0.5)) : o_nz_lfo;
e_nz_lfo = clamp(sm_nz_lfo + q_nz_lfo, 0, 1);
sm_nz_lrt = s_nz_lrt + (nz_lrt - s_nz_lrt) * sk;
q_nz_lrt = trig ? (v_nz_lrt * vel_amt * vsrc + k_nz_lrt * note_amt * ksrc + r_nz_lrt * rnd_amt * (hsh(ktrig, 31) - 0.5)) : o_nz_lrt;
e_nz_lrt = clamp(sm_nz_lrt + q_nz_lrt, 0, 1);
sm_rmb_amt = s_rmb_amt + (rmb_amt - s_rmb_amt) * sk;
q_rmb_amt = trig ? (v_rmb_amt * vel_amt * vsrc + k_rmb_amt * note_amt * ksrc + r_rmb_amt * rnd_amt * (hsh(ktrig, 32) - 0.5)) : o_rmb_amt;
e_rmb_amt = clamp(sm_rmb_amt + q_rmb_amt, 0, 1);
sm_rmb_dec = s_rmb_dec + (rmb_dec - s_rmb_dec) * sk;
q_rmb_dec = trig ? (v_rmb_dec * vel_amt * vsrc + k_rmb_dec * note_amt * ksrc + r_rmb_dec * rnd_amt * (hsh(ktrig, 33) - 0.5)) : o_rmb_dec;
e_rmb_dec = clamp(sm_rmb_dec + q_rmb_dec, 0, 1);
sm_rmb_drv = s_rmb_drv + (rmb_drv - s_rmb_drv) * sk;
q_rmb_drv = trig ? (v_rmb_drv * vel_amt * vsrc + k_rmb_drv * note_amt * ksrc + r_rmb_drv * rnd_amt * (hsh(ktrig, 34) - 0.5)) : o_rmb_drv;
e_rmb_drv = clamp(sm_rmb_drv + q_rmb_drv, 0, 1);
sm_rmb_tone = s_rmb_tone + (rmb_tone - s_rmb_tone) * sk;
q_rmb_tone = trig ? (v_rmb_tone * vel_amt * vsrc + k_rmb_tone * note_amt * ksrc + r_rmb_tone * rnd_amt * (hsh(ktrig, 35) - 0.5)) : o_rmb_tone;
e_rmb_tone = clamp(sm_rmb_tone + q_rmb_tone, 0, 1);
sm_rmb_duck = s_rmb_duck + (rmb_duck - s_rmb_duck) * sk;
q_rmb_duck = trig ? (v_rmb_duck * vel_amt * vsrc + k_rmb_duck * note_amt * ksrc + r_rmb_duck * rnd_amt * (hsh(ktrig, 36) - 0.5)) : o_rmb_duck;
e_rmb_duck = clamp(sm_rmb_duck + q_rmb_duck, 0, 1);

// ===== the voice (hand-written; make_engine.py puts it after the generated modulation block) =====
// Every e_<knob> is the knob 0..1 (smoothed) + this hit's velocity/note/random offset, clamped 0..1.
dt = 1 / samplerate;
nyq = samplerate * 0.45;
act_n = trig ? 1 : act;
tt_n = trig ? 0 : min(tt + dt, 60);
m808 = p808 > 0.5;

// ---- amp envelope: attack, then the decay; it ends exactly at LENGTH ----
// SWEEP mode: CURVE shapes (1 - x)^p (0 = drops fast, 0.5 = linear, 1 = holds).
// 808 mode: an exponential ring, CURVE = how fast (0.5 = -60 dB at LENGTH).
alen = 0.05 * pw2(e_amp_len * 5.32);              // 50 ms .. 2 s
aatt = 0.03 * e_amp_att * e_amp_att;              // 0 .. 30 ms
ax_ = clamp((tt_n - aatt) / alen, 0, 1);
adec = m808 ? exp(-ax_ * 6.9078 * shapep(e_amp_crv)) : pow(1 - ax_, shapep(e_amp_crv));
afade = min(1, (1 - ax_) * alen / 0.003);         // last 3 ms: no tick at the end
aatk = aatt > 0.00002 ? min(1, tt_n / aatt) : 1;
env = act_n * aatk * adec * afade;

// ---- SUB layer: the same oscillator (same phase: it never cancels the body), its own LENGTH / CURVE ----
slen = 0.05 * pw2(e_sub_len * 5.32);
sx_ = clamp((tt_n - aatt) / slen, 0, 1);
sdec = m808 ? exp(-sx_ * 6.9078 * shapep(e_sub_crv)) : pow(1 - sx_, shapep(e_sub_crv));
sfade = min(1, (1 - sx_) * slen / 0.003);
senv = act_n * aatk * sdec * sfade * e_sub_lvl;

// ---- pitch: the MIDI note (+ TUNE) is where the kick lands; SWEEP = how far above it starts ----
// SWEEP mode: falls within TIME along CURVE.  808 mode: the pitch follows the loudness
// (pitch = amplitude ^ p): it falls as the ring dies; TIME = how long it stays up.
fnote = 440 * pw2((knote - 69 + (e_tune - 0.5) * 48) / 12);
ptim = 0.005 * pw2(e_pit_time * 6);               // 5 .. 320 ms
py_ = min(tt_n / ptim, 1);
pesw = pow(1 - py_, shapep(e_pit_crv));
pe8 = pow(adec, 8 * pw2(-e_pit_time * 6));
pe = m808 ? pe8 : pesw;
freq = min(fnote * pw2(e_pit_swp * 72 * pe / 12), nyq);   // up to 6 octaves above the note
ph_n = trig ? 0 : fract(ph + freq * dt);
phs = e_amp_phs * 0.25;                           // PHASE: start 0 .. 90 degrees (90 = a hard attack)

// ---- FM: a sine modulator at RATIO x the body frequency, its own fast decay ----
fmr = 0.5 + e_fm_rat * 7.5;
pm_n = trig ? 0 : fract(pm + min(freq * fmr, nyq) * dt);
fidx = 6 * e_fm_amt * e_fm_amt * exp(-tt_n / (0.005 * pw2(e_fm_dec * 6)));
bosc = sin(twopi * (ph_n + phs) + fidx * sin(twopi * pm_n));
sosc = sin(twopi * (ph_n + phs));

// ---- drive settings: soft (tanh) .. HARD (clip); ASYM = the negative half harder (even harmonics) ----
dg = pw2(e_dr_amt * 5);                           // x1 .. x32
dtg = tanh(dg);
dmix = min(1, (e_dr_amt + e_dr_asym) * 5);
pre = dr_pre > 0.5;                               // PRE: shape the oscillator before the envelope (909 style:
                                                  // the dirt lasts through the whole tail); POST: the whole mix

// ---- the outgoing kick fades out over 5 ms when a new note comes (no cut, no click) ----
gph_n = trig ? fract(ph + lf * dt) : fract(gph + gf * dt);
gf_n = trig ? lf : gf;
ga_n = trig ? la : ga;
gtm_n = trig ? 0 : min(gtm + dt, 1);
gfade = max(0, 1 - gtm_n / 0.005);
gosc = sin(twopi * (gph_n + phs));

bodyv = (pre ? shp(bosc, dg, dtg, e_dr_knee, e_dr_asym, dmix) : bosc) * env;
subv = (pre ? shp(sosc, dg, dtg, e_dr_knee, e_dr_asym, dmix) : sosc) * senv;
ghost = (pre ? shp(gosc, dg, dtg, e_dr_knee, e_dr_asym, dmix) : gosc) * ga_n * gfade;
la_n = env + senv;
lf_n = freq;

// ---- partials 2..5 (SPREAD stretches them from harmonic to bell-like), darker as they decay ----
hsp = 1 + e_hm_spr * 0.6;
f2 = freq * exp(0.69314718 * hsp);
f3 = freq * exp(1.09861229 * hsp);
f4 = freq * exp(1.38629436 * hsp);
f5 = freq * exp(1.60943791 * hsp);
p2_n = trig ? 0 : fract(p2 + min(f2, nyq) * dt);
p3_n = trig ? 0 : fract(p3 + min(f3, nyq) * dt);
p4_n = trig ? 0 : fract(p4 + min(f4, nyq) * dt);
p5_n = trig ? 0 : fract(p5 + min(f5, nyq) * dt);
env2 = env * env;
hg = e_hm_amt * 0.9;
ha2 = (f2 < nyq) * 0.5 * sin(twopi * p2_n) * env2 * hg;
ha3 = (f3 < nyq) * 0.35 * sin(twopi * p3_n) * env2 * env * hg;
ha4 = (f4 < nyq) * 0.25 * sin(twopi * p4_n) * env2 * env2 * hg;
ha5 = (f5 < nyq) * 0.2 * sin(twopi * p5_n) * env2 * env2 * env * hg;
wid = e_wd_amt;
hL = ha2 + ha4 + (ha3 + ha5) * (1 - wid);
hR = ha3 + ha5 + (ha2 + ha4) * (1 - wid);

// ---- noise: stereo (WIDTH decorrelates), COLOR = low-pass, 120 Hz high-pass, own DECAY ----
nz1 = noise();
nz2 = noise();
nL = nz1;
nR = nz1 * (1 - wid) + nz2 * wid;
// LFO on the noise: a sine that runs all the time, hits or not (its own life): every hit catches it
// somewhere else. RATE 0.125 .. 64 Hz. LFO = depth: the noise level swings 0 .. 2x, its COLOR +-2 octaves
nlf_n = fract(nlf + 0.125 * pw2(e_nz_lrt * 9) * dt);
nlv = sin(twopi * nlf_n) * e_nz_lfo;
ncf = min(200 * pw2(e_nz_col * 6.3 + 2 * nlv), nyq);
nca = 1 - exp(-twopi * ncf * dt);
hpa = 1 - exp(-twopi * 120 * dt);
nlL_n = nlL + (nL - nlL) * nca;
nlR_n = nlR + (nR - nlR) * nca;
nhL_n = nhL + (nlL_n - nhL) * hpa;
nhR_n = nhR + (nlR_n - nhR) * hpa;
nenv = act_n * exp(-tt_n / (0.01 * pw2(e_nz_dec * 6.3))) * afade * min(1, tt_n / 0.0005 + 0.05);
ng = 0.9 * e_nz_amt * e_nz_amt * nenv * (1 + nlv);
noL = (nlL_n - nhL_n) * ng;
noR = (nlR_n - nhR_n) * ng;

// ---- click: a 2.5 ms burst of band-passed noise; TONE = centre, BAND = 0.25 .. 4 octaves wide ----
ctone = min(1500 * pw2(e_clk_tone * 3), nyq * 0.9);   // 1.5 .. 12 kHz
cbw = 0.25 + e_clk_bw * 3.75;
ck_ = 2 * (exp(0.34657359 * cbw) - exp(-0.34657359 * cbw)) / 2;   // 1/Q = 2 sinh(ln2/2 * bw)
cg_ = tan(pi * ctone * dt);
ca1 = 1 / (1 + cg_ * (cg_ + ck_));
ca2 = cg_ * ca1;
ca3 = cg_ * ca2;
cxL = nz1;
cxR = nz1 * (1 - wid) + nz2 * wid;
cv3L = cxL - cbL2;
cv1L = ca1 * cbL1 + ca2 * cv3L;
cv2L = cbL2 + ca2 * cbL1 + ca3 * cv3L;
cv3R = cxR - cbR2;
cv1R = ca1 * cbR1 + ca2 * cv3R;
cv2R = cbR2 + ca2 * cbR1 + ca3 * cv3R;
cbL1_n = 2 * cv1L - cbL1;
cbL2_n = 2 * cv2L - cbL2;
cbR1_n = 2 * cv1R - cbR1;
cbR2_n = 2 * cv2R - cbR2;
cbhz = ctone * (exp(0.34657359 * cbw) - exp(-0.34657359 * cbw));   // bandwidth in Hz
cnorm = min(6, pow(0.5 * samplerate / cbhz, 0.35)) * 0.55;        // narrow bands are not much quieter
cenv = act_n * exp(-tt_n / 0.0025) * 2.7 * e_clk_amt * afade * (tt_n < 0.05);
ckL = cenv * ck_ * cv1L * cnorm;
ckR = cenv * ck_ * cv1R * cnorm;

// ---- the mix, POST drive, the 8 Hz DC trap for ASYM ----
preL = bodyv + subv + ghost + hL + noL + ckL;
preR = bodyv + subv + ghost + hR + noR + ckR;
drL = pre ? preL : shp(preL, dg, dtg, e_dr_knee, e_dr_asym, dmix);
drR = pre ? preR : shp(preR, dg, dtg, e_dr_knee, e_dr_asym, dmix);
d8 = 1 - exp(-twopi * 8 * dt);
dbL0 = dbL + (drL - dbL) * d8;
dbR0 = dbR + (drR - dbR) * d8;
dbL_n = abs(dbL0) < 0.000000001 ? 0 : dbL0;
dbR_n = abs(dbR0) < 0.000000001 ? 0 : dbR0;
amix = min(1, e_dr_asym * 10);
xL = drL - dbL_n * amix;
xR = drR - dbR_n * amix;

// ---- retrigger safety: any jump left after the 5 ms crossfade fades out in ~1.5 ms ----
dk = exp(-1 / (0.0015 * samplerate));
// (only the OLD kick's jump: the new hit's own attack, e.g. PHASE 90 degrees, stays as hard as set)
gpost = pre ? ghost : shp(ghost, dg, dtg, e_dr_knee, e_dr_asym, dmix);
dcL_n = trig ? (yL - gpost) : (abs(dcL) < 0.000000001 ? 0 : dcL * dk);
dcR_n = trig ? (yR - gpost) : (abs(dcR) < 0.000000001 ? 0 : dcR * dk);
yL_n = xL + dcL_n;
yR_n = xR + dcR_n;
yLd = yL_n;
yRd = yR_n;

// ---- TUNER: the pitch the last hit really rings at: the body oscillator's own frequency (TUNE, note, every
// modulation, 808 drift included; drive / FM do not move the fundamental), averaged over the hit weighted by
// loudness^2, the sweep itself (more than 1 semitone above the note) left out. out5 = Hz, held until the next hit.
tw = (e_pit_swp * 72 * pe < 1) ? (env + senv) * (env + senv) : 0;
tsw_n = trig ? 0 : tsw + tw * freq;
tsn_n = trig ? 0 : tsn + tw;
thz_n = tsn_n > 0.000001 ? tsw_n / tsn_n : 0;

// ---- WIDTH: the stereo base. Mid/side: everything above ~180 Hz of the MID, passed through three allpasses
// (same sound, scrambled phase), is added as SIDE: L = M + S, R = M - S. L + R stays exactly the same
// (mono-safe), the sub stays in the centre. (WIDTH also decorrelates the noise / click and spreads the partials.)
wM = (yL_n + yR_n) * 0.5;
wha = 1 - exp(-twopi * 180 * dt);
wla_n = wla + (wM - wla) * wha;
wh1 = wM - wla_n;
wlb_n = wlb + (wh1 - wlb) * wha;
wh2_ = wh1 - wlb_n;
wlc_n = wlc + (wh2_ - wlc) * wha;
wh2 = wh2_ - wlc_n;                              // 3 x 6 dB/oct: 65 Hz in the side at about -28 dB
ww = wwi;
wd1 = floor(0.0031 * samplerate);
wd2 = floor(0.0047 * samplerate);
wd3 = floor(0.0073 * samplerate);
wo1 = peek(wbuf, wrapi(ww - wd1, 4096), 0);
wv1 = wh2 + 0.6 * wo1;
wa1 = wo1 - 0.6 * wv1;
wo2 = peek(wbuf, wrapi(ww - wd2, 4096), 1);
wv2 = wa1 + 0.6 * wo2;
wa2 = wo2 - 0.6 * wv2;
wo3 = peek(wbuf, wrapi(ww - wd3, 4096), 2);
wv3 = wa2 + 0.6 * wo3;
wa3 = wo3 - 0.6 * wv3;
poke(wbuf, abs(wv1) < 0.000000001 ? 0 : wv1, ww, 0);
poke(wbuf, abs(wv2) < 0.000000001 ? 0 : wv2, ww, 1);
poke(wbuf, abs(wv3) < 0.000000001 ? 0 : wv3, ww, 2);
wwi_n = wrapi(ww + 1, 4096);
wS = wa3 * wid * 1.1;
yL_n = yL_n + wS;
yR_n = yR_n - wS;

// ---- space: a small room on everything above ~180 Hz (the sub stays dry and tight) ----
sla = 1 - exp(-twopi * 180 * dt);
slL0 = slL + (yL_n - slL) * sla;
slR0 = slR + (yR_n - slR) * sla;
slL_n = abs(slL0) < 0.000000001 ? 0 : slL0;
slR_n = abs(slR0) < 0.000000001 ? 0 : slR0;
sendL = yL_n - slL_n;
sendR = yR_n - slR_n;
rsc = (0.55 + 0.9 * e_sp_time) * samplerate / 44100;
rfb = 0.62 + 0.3 * e_sp_time;
rw = rwi;
c1 = peek(room, wrapi(rw - floor(1116 * rsc), 8192), 0);
c2 = peek(room, wrapi(rw - floor(1188 * rsc), 8192), 1);
c3 = peek(room, wrapi(rw - floor(1277 * rsc), 8192), 2);
c4 = peek(room, wrapi(rw - floor(1356 * rsc), 8192), 3);
rl1_n = rl1 + (c1 - rl1) * 0.45;
rl2_n = rl2 + (c2 - rl2) * 0.45;
rl3_n = rl3 + (c3 - rl3) * 0.45;
rl4_n = rl4 + (c4 - rl4) * 0.45;
poke(room, sendL * 0.3 + rl1_n * rfb, rw, 0);
poke(room, sendR * 0.3 + rl2_n * rfb, rw, 1);
poke(room, sendL * 0.3 + rl3_n * rfb, rw, 2);
poke(room, sendR * 0.3 + rl4_n * rfb, rw, 3);
rwi_n = wrapi(rw + 1, 8192);
spm = e_sp_amt * 0.7;
outL0 = yL_n + (c1 + c3) * spm;
outR0 = yR_n + (c2 + c4) * spm;

// ---- RUMBLE (techno): the kick into a long dark reverb -> drive -> low-pass (TONE) -> ducked by the kick ----
// 4 damped combs + 2 allpasses (decay 0.5 .. 6 s), tanh drive, 2-pole low-pass 40 .. 400 Hz + 30 Hz high-pass,
// then the gain dips while the kick sounds (DUCK) and swells back after it. Mono: the low end stays centred.
rin = (yLd + yRd) * 0.5;
rT = 0.5 * pw2(e_rmb_dec * 3.585);                // 0.5 .. 6 s
rsz = (1 + 0.5 * e_rmb_dec) * samplerate / 44100;
rq = rqi;
rD1 = floor(1557 * rsz);
rD2 = floor(1617 * rsz);
rD3 = floor(1491 * rsz);
rD4 = floor(1422 * rsz);
ry1 = peek(rbuf, wrapi(rq - rD1, 16384), 0);
ry2 = peek(rbuf, wrapi(rq - rD2, 16384), 1);
ry3 = peek(rbuf, wrapi(rq - rD3, 16384), 2);
ry4 = peek(rbuf, wrapi(rq - rD4, 16384), 3);
rk1_n = rk1 + (ry1 - rk1) * 0.3;
rk2_n = rk2 + (ry2 - rk2) * 0.3;
rk3_n = rk3 + (ry3 - rk3) * 0.3;
rk4_n = rk4 + (ry4 - rk4) * 0.3;
rg1 = exp(-6.9078 * rD1 / (rT * samplerate));
rg2 = exp(-6.9078 * rD2 / (rT * samplerate));
rg3 = exp(-6.9078 * rD3 / (rT * samplerate));
rg4 = exp(-6.9078 * rD4 / (rT * samplerate));
rw1 = rin * 0.25 + rk1_n * rg1;
rw2 = rin * 0.25 + rk2_n * rg2;
rw3 = rin * 0.25 + rk3_n * rg3;
rw4 = rin * 0.25 + rk4_n * rg4;
poke(rbuf, abs(rw1) < 0.000000001 ? 0 : rw1, rq, 0);
poke(rbuf, abs(rw2) < 0.000000001 ? 0 : rw2, rq, 1);
poke(rbuf, abs(rw3) < 0.000000001 ? 0 : rw3, rq, 2);
poke(rbuf, abs(rw4) < 0.000000001 ? 0 : rw4, rq, 3);
rsum = ry1 + ry2 + ry3 + ry4;
ro5 = peek(rbuf, wrapi(rq - floor(556 * rsz), 16384), 4);
rv5 = rsum + 0.5 * ro5;
ra5 = ro5 - 0.5 * rv5;
ro6 = peek(rbuf, wrapi(rq - floor(441 * rsz), 16384), 5);
rv6 = ra5 + 0.5 * ro6;
ra6 = ro6 - 0.5 * rv6;
poke(rbuf, abs(rv5) < 0.000000001 ? 0 : rv5, rq, 4);
poke(rbuf, abs(rv6) < 0.000000001 ? 0 : rv6, rq, 5);
rqi_n = wrapi(rq + 1, 16384);
rdg = pw2(e_rmb_drv * 5);
rdr = tanh(rdg * ra6) / rdg * (1 + e_rmb_drv * 3);   // more drive = denser, a little louder
rfc = 40 * pw2(e_rmb_tone * 3.32);                // TONE 40 .. 400 Hz
rla = 1 - exp(-twopi * rfc * dt);
rl1_0 = rlp1 + (rdr - rlp1) * rla;
rl2_0 = rlp2 + (rl1_0 - rlp2) * rla;
rha = 1 - exp(-twopi * 30 * dt);
rh_0 = rhp + (rl2_0 - rhp) * rha;
rbody = rl2_0 - rh_0;
rfol = min(1, env + senv);
rdk_n = max(rfol, rdk * exp(-1 / (0.06 * samplerate)));   // follows the kick, lets go in ~60 ms
rumb = rbody * (1 - e_rmb_duck * rdk_n) * e_rmb_amt * 2.5;
outL = outL0 + rumb;
outR = outR0 + rumb;

// ---- GLUE: up to +20 dB into a clipper (louder, same peak), then LEVEL (-30 .. +6 dB), soft knee ----
gin = pw2(e_glue * 3.32);
gmix = min(1, e_glue * 20);
gL = outL + (gclip(outL * gin) - outL) * gmix;
gR = outR + (gclip(outR * gin) - outR) * gmix;
lvl = pw2((-30 + 36 * e_level) / 6.0206);
out1 = sknee(gL * lvl);
out2 = sknee(gR * lvl);
out3 = env;
out4 = sin(twopi * nlf_n);   // the noise LFO, for the panel
out5 = thz_n;                // the tuner: Hz the last hit rings at (0 = not measured yet)

