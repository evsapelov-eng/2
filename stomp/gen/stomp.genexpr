// STØMP — kick drum voice for a [gen~] codebox. GENERATED by tools/make_engine.py from tools/spec.py
// and gen/voice.part.genexpr — edit those, then `npm run gen`.
// Rules (from FLØCK's real-Max lessons): functions first, then Param/Data/History; History written
// only at the top level at the end of the pass; no loops.
// Messages: ktrig <n> (a new value = a new hit), knote <0..127>, kvel <0..1>, plus every knob.
// in1: unused (instrument).  out1/out2: L/R.  out3: amp envelope (panel).
sknee(x) { ax = abs(x); return ax < 0.9 ? x : (x < 0 ? -1 : 1) * (0.9 + 0.1 * tanh((ax - 0.9) / 0.1)); }
pw2(x) { return exp(x * 0.69314718); }
shapep(v) { return pw2((0.5 - v) * 6); }
wrapi(i, n) { return i < 0 ? i + n : (i >= n ? i - n : i); }

Param ktrig(0);
Param knote(36, min=0, max=127);
Param kvel(1, min=0, max=1);
Param amp_len(0.52, min=0, max=1);
Param amp_att(0, min=0, max=1);
Param amp_crv(0.38, min=0, max=1);
Param pit_swp(0.55, min=0, max=1);
Param pit_time(0.42, min=0, max=1);
Param pit_crv(0.62, min=0, max=1);
Param clk_amt(0.35, min=0, max=1);
Param clk_tone(0.45, min=0, max=1);
Param nz_amt(0.12, min=0, max=1);
Param nz_col(0.55, min=0, max=1);
Param nz_dec(0.25, min=0, max=1);
Param hm_amt(0.15, min=0, max=1);
Param hm_spr(0, min=0, max=1);
Param dr_amt(0.35, min=0, max=1);
Param dr_knee(0.25, min=0, max=1);
Param fm_amt(0.08, min=0, max=1);
Param fm_rat(0.2, min=0, max=1);
Param fm_dec(0.35, min=0, max=1);
Param wd_amt(0, min=0, max=1);
Param sp_amt(0, min=0, max=1);
Param sp_time(0.35, min=0, max=1);
Param level(0.75, min=0, max=1);
Param tune(0.5, min=0, max=1);
Param vel_amt(0.5, min=0, max=1);
Param rnd_amt(0.5, min=0, max=1);
Param v_amp_len(0, min=-1, max=1);
Param v_amp_att(0, min=-1, max=1);
Param v_amp_crv(0, min=-1, max=1);
Param v_pit_swp(0, min=-1, max=1);
Param v_pit_time(0, min=-1, max=1);
Param v_pit_crv(0, min=-1, max=1);
Param v_clk_amt(0.6, min=-1, max=1);
Param v_clk_tone(0, min=-1, max=1);
Param v_nz_amt(0, min=-1, max=1);
Param v_nz_col(0, min=-1, max=1);
Param v_nz_dec(0, min=-1, max=1);
Param v_hm_amt(0, min=-1, max=1);
Param v_hm_spr(0, min=-1, max=1);
Param v_dr_amt(0.3, min=-1, max=1);
Param v_dr_knee(0, min=-1, max=1);
Param v_fm_amt(0, min=-1, max=1);
Param v_fm_rat(0, min=-1, max=1);
Param v_fm_dec(0, min=-1, max=1);
Param v_wd_amt(0, min=-1, max=1);
Param v_sp_amt(0, min=-1, max=1);
Param v_sp_time(0, min=-1, max=1);
Param v_level(1, min=-1, max=1);
Param v_tune(0, min=-1, max=1);
Param r_amp_len(0, min=-1, max=1);
Param r_amp_att(0, min=-1, max=1);
Param r_amp_crv(0, min=-1, max=1);
Param r_pit_swp(0.1, min=-1, max=1);
Param r_pit_time(0, min=-1, max=1);
Param r_pit_crv(0, min=-1, max=1);
Param r_clk_amt(0, min=-1, max=1);
Param r_clk_tone(0.3, min=-1, max=1);
Param r_nz_amt(0, min=-1, max=1);
Param r_nz_col(0.3, min=-1, max=1);
Param r_nz_dec(0, min=-1, max=1);
Param r_hm_amt(0, min=-1, max=1);
Param r_hm_spr(0, min=-1, max=1);
Param r_dr_amt(0, min=-1, max=1);
Param r_dr_knee(0, min=-1, max=1);
Param r_fm_amt(0, min=-1, max=1);
Param r_fm_rat(0, min=-1, max=1);
Param r_fm_dec(0, min=-1, max=1);
Param r_wd_amt(0, min=-1, max=1);
Param r_sp_amt(0, min=-1, max=1);
Param r_sp_time(0, min=-1, max=1);
Param r_level(0, min=-1, max=1);
Param r_tune(0, min=-1, max=1);
Data room(8192, 4);
History init(0);
History lastk(0);
History s_amp_len(0.52);
History o_amp_len(0);
History s_amp_att(0);
History o_amp_att(0);
History s_amp_crv(0.38);
History o_amp_crv(0);
History s_pit_swp(0.55);
History o_pit_swp(0);
History s_pit_time(0.42);
History o_pit_time(0);
History s_pit_crv(0.62);
History o_pit_crv(0);
History s_clk_amt(0.35);
History o_clk_amt(0);
History s_clk_tone(0.45);
History o_clk_tone(0);
History s_nz_amt(0.12);
History o_nz_amt(0);
History s_nz_col(0.55);
History o_nz_col(0);
History s_nz_dec(0.25);
History o_nz_dec(0);
History s_hm_amt(0.15);
History o_hm_amt(0);
History s_hm_spr(0);
History o_hm_spr(0);
History s_dr_amt(0.35);
History o_dr_amt(0);
History s_dr_knee(0.25);
History o_dr_knee(0);
History s_fm_amt(0.08);
History o_fm_amt(0);
History s_fm_rat(0.2);
History o_fm_rat(0);
History s_fm_dec(0.35);
History o_fm_dec(0);
History s_wd_amt(0);
History o_wd_amt(0);
History s_sp_amt(0);
History o_sp_amt(0);
History s_sp_time(0.35);
History o_sp_time(0);
History s_level(0.75);
History o_level(0);
History s_tune(0.5);
History o_tune(0);
History act(0);
History tt(0);
History ph(0);
History pm(0);
History p2(0);
History p3(0);
History p4(0);
History p5(0);
History nlL(0);
History nlR(0);
History nhL(0);
History nhR(0);
History dcL(0);
History dcR(0);
History yL(0);
History yR(0);
History slL(0);
